# Provider token from App Store Connect > App Analytics > Campaigns.
# Apple ignores the `ct` campaign value on store links unless `pt` accompanies it.
# The account's token is already the default in src/utils/appLinks.ts; set this
# only to override it (a different Apple account, or a staging build).
PUBLIC_APPLE_PROVIDER_TOKEN=
