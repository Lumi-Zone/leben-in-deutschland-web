# Copy this file to .env.x.local after creating an App in the X Developer Console.
# Never commit the real values.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Posting is blocked unless this is explicitly set to true.
X_ENABLE_POSTING=false

# Safety check: the authenticated X account must match this username.
X_ACCOUNT_USERNAME=300Fragen
