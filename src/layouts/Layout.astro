---
import "../styles/global.css";
import { languages, useTranslations } from '../i18n/ui';
import { getPath } from '../utils/navigation';
import { getSeoLanguageMeta, serializeJsonLd } from '../utils/seo';
import { ANDROID_PACKAGE_ID, APP_STORE_URL, IOS_APP_ID, MOBILE_APP_NAME, PLAY_STORE_URL, buildStoreUrls } from '../utils/appLinks';
import { FACEBOOK_URL } from '../utils/social';

interface Props {
  title: string;
  lang?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  authors?: string[];
  noindex?: boolean;
  disableAlternates?: boolean;
  alternateLangs?: string[];
  rssHref?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  prevHref?: string;
  nextHref?: string;
}

const {
	title,
	lang = 'de',
	description = "Kostenloses Training für den 'Leben in Deutschland' Test & Einbürgerungstest. Alle 300+ offiziellen Fragen für 2026. Jetzt üben!",
	canonical,
	keywords = "leben in deutschland, einbürgerung, einbürgerungstest, bamf, 300 fragen, integrationskurs, bundesland fragen, politikkurs, orientierung, orientierungskurs, 310 fragen, test leben in deutschland, bayern fragen, berlin fragen, hamburg fragen",
	image = "/og/og-default.png",
	imageAlt = "Leben in Deutschland App - Einbuergerungstest 2026 Vorbereitung",
	imageWidth = 1200,
	imageHeight = 630,
	imageType = "image/png",
	ogType = 'website',
	publishedTime,
	modifiedTime,
	authors = [],
	noindex = false,
	disableAlternates = false,
	alternateLangs,
	rssHref,
	jsonLd,
	prevHref,
	nextHref,
} = Astro.props;
const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, siteUrl);
const canonicalHref = canonical ? new URL(canonical, siteUrl).href : canonicalURL.href;
const currentLanguageMeta = getSeoLanguageMeta(lang);

// Generate language alternates while preserving base path and route.
const languageCodes = Object.keys(languages);
const seoLanguageCodes = (alternateLangs?.length ? alternateLangs : languageCodes).filter((languageCode) =>
  languageCodes.includes(languageCode)
);
const baseSegments = getPath('/').split('/').filter(Boolean);
const pathSegments = currentPath.split('/').filter(Boolean);
const pathWithoutBase =
  baseSegments.length > 0 &&
  baseSegments.every((segment, index) => pathSegments[index] === segment)
    ? pathSegments.slice(baseSegments.length)
    : pathSegments;
const routeSegments =
  pathWithoutBase.length > 0 && languageCodes.includes(pathWithoutBase[0])
    ? pathWithoutBase.slice(1)
    : pathWithoutBase;

const getLocalizedHref = (targetLang: string) =>
  new URL(getPath(`${[targetLang, ...routeSegments].join('/')}/`), siteUrl).href;

const alternates = seoLanguageCodes.map((languageCode) => ({
  lang: getSeoLanguageMeta(languageCode).hrefLang,
  ogLocale: getSeoLanguageMeta(languageCode).ogLocale,
  href: getLocalizedHref(languageCode),
}));
const defaultAlternateLang = seoLanguageCodes.includes('de') ? 'de' : seoLanguageCodes[0] ?? 'de';
const xDefaultHref = getLocalizedHref(defaultAlternateLang);
const socialImagePath = image === '/logo.png' ? '/og/og-default.png' : image;
const resolvedImagePath =
	socialImagePath.startsWith('http://') || socialImagePath.startsWith('https://')
		? socialImagePath
		: getPath(socialImagePath);
const socialImageURL = new URL(resolvedImagePath, siteUrl).href;
const robotsValue = noindex
	? 'noindex, follow, noarchive'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const rtlLanguageCodes = new Set(['ar', 'fa', 'ps']);
const documentDirection = rtlLanguageCodes.has(lang) ? 'rtl' : 'ltr';
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION?.trim();
const prevLinkHref = prevHref ? new URL(prevHref, siteUrl).href : undefined;
const nextLinkHref = nextHref ? new URL(nextHref, siteUrl).href : undefined;
const defaultUmamiWebsiteId = '44695de0-fce5-49b9-b5f4-61767b8568df';
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim() || defaultUmamiWebsiteId;
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL?.trim() || 'https://cloud.umami.is/script.js';
const umamiDomains = import.meta.env.PUBLIC_UMAMI_DOMAINS?.trim() || 'lid-einbuergerung.de';
const bannerTranslate = useTranslations(lang as Parameters<typeof useTranslations>[0]);
const bannerStore = buildStoreUrls({ source: 'smart-banner', lang });
const bannerGetLabel = bannerTranslate('banner.get');
const bannerDismissLabel = bannerTranslate('banner.dismiss');
---

<!doctype html>
<html lang={currentLanguageMeta.htmlLang} dir={documentDirection}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="facebook-domain-verification" content="beoito4jjn72r24md8ueoukzj0hwjn" />
		<link rel="icon" type="image/svg+xml" href={getPath("favicon.svg")} />
		<link rel="alternate icon" href={getPath("favicon.ico")} sizes="32x32" />
		<link rel="apple-touch-icon" href={getPath("logo.png")} />
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content="Leben in Deutschland" />
		<meta name="theme-color" content="#182d26" />
		<meta name="format-detection" content="telephone=no" />
        <meta name="apple-itunes-app" content={`app-id=${IOS_APP_ID}, app-argument=${canonicalHref}`} />
        <meta name="google-play-app" content={`app-id=${ANDROID_PACKAGE_ID}`} />
        <meta property="al:ios:app_name" content={MOBILE_APP_NAME} />
        <meta property="al:ios:app_store_id" content={IOS_APP_ID} />
        <meta property="al:ios:url" content={canonicalHref} />
        <meta property="al:android:app_name" content={MOBILE_APP_NAME} />
        <meta property="al:android:package" content={ANDROID_PACKAGE_ID} />
        <meta property="al:android:url" content={canonicalHref} />
        <meta property="al:web:url" content={canonicalHref} />
        
        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={robotsValue} />
        {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
        {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
        <meta name="keywords" content={keywords} />
        {authors[0] && <meta name="author" content={authors[0]} />}
        <link rel="canonical" href={canonicalHref} />
        {rssHref && <link rel="alternate" type="application/rss+xml" title="Blog RSS" href={rssHref} />}
        {prevLinkHref && <link rel="prev" href={prevLinkHref} />}
        {nextLinkHref && <link rel="next" href={nextLinkHref} />}

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="Leben in Deutschland" />
        <meta property="og:locale" content={currentLanguageMeta.ogLocale} />
        {!disableAlternates && alternates
          .filter((alt) => alt.ogLocale !== currentLanguageMeta.ogLocale)
          .map((alt) => <meta property="og:locale:alternate" content={alt.ogLocale} />)}
        <meta property="og:url" content={canonicalHref} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:image:secure_url" content={socialImageURL} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:image:type" content={imageType} />
        <meta property="og:image:width" content={String(imageWidth)} />
        <meta property="og:image:height" content={String(imageHeight)} />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        {authors.map((author) => <meta property="article:author" content={author} />)}
        {ogType === 'article' && <meta property="article:publisher" content={FACEBOOK_URL} />}

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@300Fragen" />
        <meta name="twitter:url" content={canonicalHref} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <meta name="twitter:app:name:iphone" content={MOBILE_APP_NAME} />
        <meta name="twitter:app:id:iphone" content={IOS_APP_ID} />
        <meta name="twitter:app:url:iphone" content={APP_STORE_URL} />
        <meta name="twitter:app:name:googleplay" content={MOBILE_APP_NAME} />
        <meta name="twitter:app:id:googleplay" content={ANDROID_PACKAGE_ID} />
        <meta name="twitter:app:url:googleplay" content={PLAY_STORE_URL} />
        
        <!-- Hreflang for Internationalization -->
        {!disableAlternates && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
        {!disableAlternates && alternates.map(alt => (
            <link rel="alternate" hreflang={alt.lang} href={alt.href} />
        ))}
        {jsonLdItems.map((item) => (
            <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />
        ))}
        {umamiWebsiteId && (
            <script
                is:inline
                defer
                src={umamiScriptUrl}
                data-website-id={umamiWebsiteId}
                data-domains={umamiDomains || undefined}
            ></script>
        )}
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>

		<div id="smart-app-banner" class="smart-banner" hidden>
			<button type="button" id="smart-banner-close" class="smart-banner-close" aria-label={bannerDismissLabel}>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
				</svg>
			</button>

			<div class="smart-banner-icon" aria-hidden="true">
				<img src={getPath("logo.png")} alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
			</div>

			<div class="smart-banner-content">
				<h3>Leben in Deutschland 2026</h3>
				<p>Lumi-Zone</p>
			</div>

			<a
				id="smart-banner-open"
				class="smart-banner-open"
				href={bannerStore.android}
				rel="noopener noreferrer"
			>
				{bannerGetLabel}
			</a>
		</div>
		<div id="main-content" tabindex="-1">
			<slot />
		</div>

		<script is:inline define:vars={{ iosStoreUrl: bannerStore.ios, androidStoreUrl: bannerStore.android }}>
			(() => {
				const banner = document.getElementById('smart-app-banner');
				const closeButton = document.getElementById('smart-banner-close');
				const openLink = document.getElementById('smart-banner-open');
				if (!banner || !closeButton || !openLink) return;

				const track = (eventName, data) => {
					try {
						if (typeof window.umami?.track === 'function') window.umami.track(eventName, data);
					} catch {
						/* no-op */
					}
				};

				const ua = navigator.userAgent || '';
				const isAndroid = /android/i.test(ua);
				// An iPad requesting the desktop site reports a Macintosh user agent, so
				// touch capability is what separates it from an actual Mac.
				const isIOS = /iPad|iPhone|iPod/.test(ua)
					|| (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
				if (!isAndroid && !isIOS) return;

				// Social apps render pages in their own webview, where neither Apple's
				// Smart App Banner nor Chrome's native prompt appears. That is exactly
				// where the site's Instagram and X traffic lands, so the banner has to
				// cover it itself.
				const isInAppBrowser = /Instagram|FBAN|FBAV|FB_IAB|FBIOS|Line\/|TikTok|musical_ly|Snapchat|LinkedInApp|Twitter|WhatsApp|Telegram|Pinterest/i.test(ua);

				// iOS Safari already shows Apple's own banner from the
				// `apple-itunes-app` meta tag; a second one would just stack on top.
				const isIOSSafari = isIOS
					&& /Safari/i.test(ua)
					&& !/CriOS|FxiOS|EdgiOS|OPiOS/i.test(ua)
					&& !isInAppBrowser;
				if (isIOSSafari) return;

				const platform = isAndroid ? 'android' : 'ios';
				const context = isInAppBrowser ? 'in-app-browser' : 'browser';
				openLink.href = isAndroid ? androidStoreUrl : iosStoreUrl;

				// A dismissal silences the banner for 30 days rather than forever, so a
				// visitor returning months later is still offered the app.
				const DISMISS_KEY = 'smart-banner-dismissed-at';
				const DISMISS_DAYS = 30;
				let dismissedAt = 0;
				try {
					const stored = localStorage.getItem(DISMISS_KEY);
					// Migrate the previous boolean flag so existing dismissals are honoured.
					if (stored === null && localStorage.getItem('smart-banner-closed') === 'true') {
						dismissedAt = Date.now();
						localStorage.setItem(DISMISS_KEY, String(dismissedAt));
						localStorage.removeItem('smart-banner-closed');
					} else {
						dismissedAt = Number(stored) || 0;
					}
				} catch {
					dismissedAt = 0;
				}

				const dismissalExpired = Date.now() - dismissedAt > DISMISS_DAYS * 24 * 60 * 60 * 1000;
				if (!dismissalExpired) return;

				banner.hidden = false;
				track('smart-banner-shown', { platform, context });

				closeButton.addEventListener('click', () => {
					banner.hidden = true;
					track('smart-banner-dismissed', { platform, context });
					try {
						localStorage.setItem(DISMISS_KEY, String(Date.now()));
					} catch {
						/* no-op */
					}
				});

				openLink.addEventListener('click', () => {
					track(isAndroid ? 'play-store-click' : 'app-store-click', {
						location: 'smart-banner',
						platform,
						context,
					});
				});
			})();
		</script>
		<script is:inline>
			(() => {
				// A visitor who scanned a desktop QR code, or arrived from a social
				// post, carries that origin in the URL. Fold it into the campaign token
				// of every store link on the page, so an install is attributed to how
				// the visitor arrived and not only to the button they finally pressed.
				// Runs after the banner script so it covers that link too.
				const params = new URLSearchParams(window.location.search);
				const arrival = (params.get('src') || params.get('utm_source') || '').toLowerCase();
				const origin = arrival.replace(/[^a-z0-9_-]/g, '').slice(0, 24);
				if (!origin) return;

				const links = document.querySelectorAll('a[href*="apps.apple.com"], a[href*="play.google.com"]');
				for (const link of links) {
					let url;
					try {
						url = new URL(link.href);
					} catch {
						continue;
					}

					if (url.hostname.endsWith('apps.apple.com')) {
						const existing = url.searchParams.get('ct');
						url.searchParams.set('ct', (existing ? origin + '-' + existing : origin).slice(0, 40));
					} else {
						const referrer = new URLSearchParams(url.searchParams.get('referrer') || '');
						referrer.set('utm_source', origin);
						url.searchParams.set('referrer', referrer.toString());
					}

					link.href = url.href;
				}
			})();
		</script>
	</body>
</html>



<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.5rem 0.75rem;
		background: #1d4ed8;
		color: #ffffff;
		border-radius: 0.5rem;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-180%);
		transition: transform 150ms ease;
		z-index: 10000;
	}

	.skip-link:focus {
		transform: translateY(0);
	}


	.smart-banner {
		position: relative;
		background:
			radial-gradient(circle at 18% 0%, rgba(236, 214, 150, 0.48), transparent 44%),
			#f8f4ee;
		border-bottom: 1px solid #d9cdbf;
		box-shadow: 0 4px 18px rgba(62, 49, 38, 0.12);
		padding: max(0.65rem, env(safe-area-inset-top)) 0.75rem 0.65rem;
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.smart-banner[hidden] { display: none; }

	.smart-banner-close {
		min-width: 44px;
		min-height: 44px;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem;
		border: none;
		background: transparent;
		color: #8c7c6c;
		cursor: pointer;
	}

	.smart-banner-icon {
		width: 2.7rem;
		height: 2.7rem;
		border-radius: 0.75rem;
		overflow: hidden;
		background: #fffdf9;
		border: 1px solid #ddcfbf;
		box-shadow: 0 5px 14px rgba(64, 49, 37, 0.14);
		flex-shrink: 0;
	}

	.smart-banner-content {
		min-width: 0;
		flex: 1;
	}

	.smart-banner-content h3 {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.2;
		color: #2d261f;
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.smart-banner-content p {
		margin: 0.15rem 0 0;
		font-size: 0.75rem;
		color: #75685c;
	}

	.smart-banner-open {
		min-height: 44px;
		flex-shrink: 0;
		/* Rendered as a link so the store URL is visible to the browser and to
		   assistive technology, which needs the anchor to be laid out like the
		   button it replaced. */
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		text-decoration: none;
		border: none;
		border-radius: 999px;
		background: #3f352c;
		color: #ffffff;
		font-weight: 700;
		font-size: 0.75rem;
		padding: 0.4rem 0.75rem;
		cursor: pointer;
		box-shadow: 0 4px 12px rgba(54, 43, 34, 0.18);
	}


</style>
