---
import Layout from '../../layouts/Layout.astro';
import questions from '../../data/questions.json';
import { useTranslations } from '../../i18n/ui';
import StateQuestionExplorer from '../../components/StateQuestionExplorer';
import { GERMAN_STATES } from '../../data/germanStates';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
type QuestionItem = (typeof questions)[number];

interface StateQuestionsProps {
  stateName: string;
  questions: QuestionItem[];
  lang: SupportedLang;
}

export function getStaticPaths() {
  const paths: Array<{
    params: { lang: SupportedLang; state: string };
    props: StateQuestionsProps;
  }> = [];

  SUPPORTED_LANGUAGES.forEach((lang) => {
    GERMAN_STATES.forEach((state) => {
        const stateQuestions = questions.filter(q => q.area_code === 'land' && q.thema === state.name);

        paths.push({
            params: { lang, state: state.slug },
            props: { stateName: state.name, questions: stateQuestions, lang },
        });
    });
  });
  
  return paths;
}

const { stateName, questions: stateQuestions, lang } = Astro.props as StateQuestionsProps;
const t = useTranslations(lang);
import Header from '../../components/Header.astro';
import { getPath } from '../../utils/navigation';
---

<Layout
  title={`Leben in Deutschland - ${stateName} Fragen`}
  description={`${stateName}: Offizielle Bundesland-Fragen für den Einbürgerungstest und Leben in Deutschland.`}
  image="/logo.png"
  lang={lang}
>
  <Header lang={lang} />
  <main class="app-page">
    <div class="app-page-shell">
      <div class="mb-6">
        <a href={getPath(`${lang}/`)} class="inline-flex items-center rounded-xl border border-blue-200 bg-blue-50 px-3.5 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100">← {t("question.back")}</a>
      </div>

      <div class="premium-panel p-6 md:p-8 text-center mb-8">
        <span class="chip mb-2">{t("progress.topic_land")}</span>
        <h1 class="section-heading">{stateName}</h1>
        <p class="section-subtitle max-w-2xl mx-auto">
          {t("home.sample_questions")}
        </p>
      </div>

      <StateQuestionExplorer
        client:visible
        lang={lang}
        stateName={stateName}
        questions={stateQuestions}
        labels={{
          searchPlaceholder: t("state.search_placeholder"),
          searchAriaLabel: t("state.search_label"),
          sortLabel: t("state.sort_label"),
          sortDefault: t("state.sort_default"),
          sortIdAsc: t("state.sort_id_asc"),
          sortIdDesc: t("state.sort_id_desc"),
          viewLabel: t("state.view_label"),
          viewGrid: t("state.view_grid"),
          viewList: t("state.view_list"),
          clearSearch: t("state.clear"),
          results: t("state.results"),
          emptyTitle: t("state.empty_title"),
          emptySubtitle: t("state.empty_subtitle"),
        }}
      />
    </div>
  </main>
</Layout>
