---
import Layout from '../../layouts/Layout.astro';
import AppInstallQr from '../../components/AppInstallQr.astro';
import Header from '../../components/Header.astro';
import questions from '../../data/questions.json';
import questionPdfs from '../../data/questionPdfs.json';
import { PDF_LANGUAGES, PDF_ROUTE, pdfLandingContent, type PdfLanguage } from '../../data/pdfLandingContent';
import { BAMF_QUESTION_CATALOG, BAMF_TEST_SOURCE } from '../../data/seoLandingContent';
import { buildStoreUrls } from '../../utils/appLinks';
import { getPath } from '../../utils/navigation';
import { getLocalizedQuestionText, parseCorrectIndex } from '../../utils/questions';

export function getStaticPaths() {
  return PDF_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props as { lang: PdfLanguage };
const copy = pdfLandingContent[lang];
const file = questionPdfs.files[lang];
const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const canonicalPath = getPath(`${lang}/${PDF_ROUTE}/`);
const pageUrl = new URL(canonicalPath, siteUrl).href;
const fileUrl = new URL(file.path, siteUrl).href;
const fileName = file.path.split('/').pop();
const size = new Intl.NumberFormat(lang === 'ua' ? 'uk' : lang, { maximumFractionDigits: 1 }).format(file.bytes / 1048576);
const fileMeta = copy.fileMeta(file.pages, size);
const formatDate = (isoDate: string) => isoDate.split('-').reverse().join('.');
const checkedText = copy.checked(formatDate(questionPdfs.answersCheckedOn), formatDate(questionPdfs.catalogueStand));
const storeLinks = buildStoreUrls({ source: 'pdf-guide', lang });
const samples = [1, 3, 10].map((id) => {
  const question = questions.find((candidate) => candidate.id === id)!;
  const answer = `a${parseCorrectIndex(question.solution) + 1}`;
  const read = (language: string) => (question as unknown as Record<string, string>)[`${answer}_${language}`];
  return { id, german: question.q_de, germanAnswer: read('de'), translated: getLocalizedQuestionText(question, lang), translatedAnswer: read(lang) };
});
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${pageUrl}#webpage`, name: copy.title, description: copy.description, url: pageUrl, inLanguage: lang, dateModified: questionPdfs.answersCheckedOn, citation: [BAMF_TEST_SOURCE, BAMF_QUESTION_CATALOG] },
    { '@type': 'LearningResource', '@id': `${pageUrl}#pdf`, name: copy.heading, description: copy.description, url: pageUrl, inLanguage: lang === 'de' ? 'de' : [lang, 'de'], learningResourceType: 'Study guide', educationalLevel: 'adult education', isAccessibleForFree: true, dateModified: questionPdfs.answersCheckedOn, encoding: { '@type': 'MediaObject', contentUrl: fileUrl, encodingFormat: 'application/pdf', contentSize: `${size} MB` } },
    { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: copy.faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
    { '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumb`, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Leben in Deutschland', item: new URL(getPath(`${lang}/`), siteUrl).href },
      { '@type': 'ListItem', position: 2, name: copy.heading, item: pageUrl },
    ] },
  ],
};
---

<Layout title={copy.title} description={copy.description} keywords={copy.keywords} canonical={canonicalPath}
  jsonLd={schema} lang={lang} alternateLangs={[...PDF_LANGUAGES]}>
  <Header lang={lang} alternateLangs={[...PDF_LANGUAGES]} />
  <main class="app-page bg-slate-50">
    <section class="border-b border-slate-200 bg-slate-950 text-white">
      <div class="container mx-auto max-w-5xl px-4 py-12 md:py-16">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-blue-200">{copy.eyebrow}</p>
        <h1 class="max-w-4xl text-4xl font-extrabold tracking-tight md:text-5xl">{copy.heading}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-200 md:text-xl">{copy.lead}</p>
        <div class="mt-7">
          <a class="inline-flex min-h-12 items-center rounded-xl bg-blue-500 px-6 py-3 text-lg font-bold hover:bg-blue-400" href={file.path} download={fileName} data-umami-event="pdf-download" data-pdf-download={lang}>{copy.download}</a>
          <p class="mt-3 text-sm text-slate-300">{fileMeta}</p>
        </div>
        <p class="mt-6 max-w-3xl rounded-xl border border-amber-300/30 bg-amber-100/10 p-4 text-sm leading-relaxed text-amber-50">{copy.note}</p>
      </div>
    </section>

    <section class="container mx-auto max-w-6xl px-4 py-10">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {copy.facts.map((fact) => <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><strong class="text-3xl text-blue-700" dir="ltr">{fact.value}</strong><p class="mt-2 font-bold text-slate-950">{fact.label}</p></div>)}
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white">
      <div class="container mx-auto grid max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[minmax(0,1fr)_340px]">
        <article>
          <h2 class="text-3xl font-extrabold text-slate-950">{copy.includesTitle}</h2>
          <ul class="mt-5 list-disc space-y-2 ps-5 leading-relaxed text-slate-700">{copy.includes.map((item) => <li>{item}</li>)}</ul>
        </article>
        <aside class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6">
          <h2 class="text-xl font-bold text-slate-950">{copy.checkedTitle}</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-700">{checkedText}</p>
          <ul class="mt-4 space-y-3 text-sm font-semibold text-blue-800">
            <li><a class="hover:underline" href={BAMF_TEST_SOURCE} target="_blank" rel="noopener noreferrer">BAMF: Einbürgerungstest ↗</a></li>
            <li><a class="hover:underline" href={BAMF_QUESTION_CATALOG} target="_blank" rel="noopener noreferrer">BAMF: Online-Testcenter ↗</a></li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="container mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-3xl font-extrabold text-slate-950">{copy.sampleTitle}</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-700">{copy.sampleText}</p>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {samples.map((sample) => <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="font-bold text-slate-950" lang="de" dir="ltr">{sample.german}</p>
          {lang !== 'de' && <p class="mt-2 text-slate-700">{sample.translated}</p>}
          <p class="mt-4 text-xs font-bold uppercase tracking-wide text-emerald-800">{copy.correctLabel}</p>
          <p class="mt-1 font-semibold text-emerald-900" lang="de" dir="ltr">{sample.germanAnswer}</p>
          {lang !== 'de' && <p class="mt-1 text-emerald-900">{sample.translatedAnswer}</p>}
          <a class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-blue-800 underline underline-offset-4" href={getPath(`${lang}/frage/${sample.id}/`)}>#{sample.id} →</a>
        </article>)}
      </div>
    </section>

    <section class="border-t border-slate-200 bg-white">
      <div class="container mx-auto grid max-w-6xl gap-8 px-4 py-12 lg:grid-cols-[minmax(0,1fr)_360px]">
        <article>
          <h2 class="text-3xl font-extrabold text-slate-950">{copy.appTitle}</h2>
          <p class="mt-4 max-w-3xl leading-relaxed text-slate-700">{copy.appText}</p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={storeLinks.ios} target="_blank" rel="noopener noreferrer" data-umami-event="app-store-click" data-umami-event-location="pdf-guide" data-umami-event-lang={lang} class="rounded-xl bg-slate-950 px-5 py-3 text-center font-bold text-white">App Store</a>
            <a href={storeLinks.android} target="_blank" rel="noopener noreferrer" data-umami-event="play-store-click" data-umami-event-location="pdf-guide" data-umami-event-lang={lang} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-center font-bold text-slate-950">Google Play</a>
            <a href={getPath(`${lang}/exam/`)} class="rounded-xl border border-blue-200 bg-blue-50 px-5 py-3 text-center font-bold text-blue-800">{copy.examCta}</a>
            <a href={getPath(`${lang}/fragen/`)} class="rounded-xl border border-blue-200 bg-blue-50 px-5 py-3 text-center font-bold text-blue-800">{copy.catalogCta}</a>
          </div>
          <AppInstallQr lang={lang} placement="pdf-guide" class="mt-6" />
        </article>
        <aside>
          <h2 class="text-2xl font-extrabold text-slate-950">FAQ</h2>
          <div class="mt-4 space-y-3">{copy.faq.map((item) => <details class="rounded-xl border border-slate-200 bg-white p-4"><summary class="cursor-pointer font-bold text-slate-950">{item.question}</summary><p class="mt-3 text-sm leading-relaxed text-slate-700">{item.answer}</p></details>)}</div>
        </aside>
      </div>
    </section>
  </main>
</Layout>
