---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FavoritesList from '../../components/FavoritesList';
import { useTranslations } from '../../i18n/ui';
import { getPath } from '../../utils/navigation';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: SupportedLang };
const t = useTranslations(lang);
---

<Layout
  title={`${t("favorites.page_title")} - ${t("hero.title")}`}
  description={t("favorites.subtitle")}
  image="/logo.png"
  noindex={true}
  disableAlternates={true}
  lang={lang}
>
  <Header lang={lang} />

  <main class="app-page">
    <div class="app-page-shell">
      <div class="max-w-4xl mx-auto mb-6">
        <a href={getPath(`${lang}/`)} class="inline-flex items-center rounded-xl border border-blue-200 bg-blue-50 px-3.5 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100">← {t("question.back")}</a>
      </div>

      <FavoritesList
        client:visible
        lang={lang}
        labels={{
          title: t("favorites.title"),
          subtitle: t("favorites.subtitle"),
          empty: t("favorites.empty"),
          remove: t("favorites.remove"),
          clearAll: t("favorites.clear_all"),
          gotoQuestion: t("favorites.goto_question"),
        }}
      />
    </div>
  </main>
</Layout>
