---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../../i18n/ui';
import { getPath } from '../../../../utils/navigation';
import type { SupportedLang } from '../../../../types/language';
import { getAllAuthors, getAuthorByName, getAuthorBySlug, getLocalizedAuthor } from '../../../../data/blogAuthors';
import { blogCopy, blogLocales, getEditorialPolicyLang } from '../../../../i18n/blog';
import { testNames } from '../../../../i18n/seo';
import {
  getBlogImageAlt,
  getOptimizedImageSizes,
  getOptimizedImageSrcset,
  getOptimizedImageUrl,
  toSlug,
} from '../../../../utils/blog';
import { getBlogLanguages, getPostImage, getRouteSlug } from '../../../../utils/blogTranslations';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return getBlogLanguages(posts).flatMap((lang) => {
    const langPosts = posts.filter((post) => post.data.lang === lang);
    // German keeps every known profile; other languages only list authors with guides in that language.
    const authorSlugs = new Set(lang === 'de' ? getAllAuthors().map((entry) => entry.slug) : []);
    langPosts.forEach((post) => authorSlugs.add(toSlug(post.data.author)));
    return Array.from(authorSlugs).map((authorSlug) => ({
      params: { lang, author: authorSlug },
      props: { lang, author: authorSlug },
    }));
  });
}

const { lang, author } = Astro.props as { lang: SupportedLang; author: string };
const t = useTranslations(lang);
const posts = await getCollection('blog');
const matchedPostAuthor = posts.find((post) => toSlug(post.data.author) === author)?.data.author;
const profile = getLocalizedAuthor(getAuthorBySlug(author) ?? getAuthorByName(matchedPostAuthor ?? author), lang);
const labels = blogCopy[lang];

const locale = blogLocales[lang];
const dateFormatter = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' });

const authorPosts = posts
  .filter((post) => post.data.lang === lang && toSlug(post.data.author) === profile.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id))
  .map((post) => {
    const image = getPostImage(post, posts);
    return {
      ...post,
      image,
      imageAlt: getBlogImageAlt(post.data.title),
      srcset: getOptimizedImageSrcset(image),
      imageSrc: getOptimizedImageUrl(image, 1366),
      url: getPath(`${lang}/blog/${getRouteSlug(post)}`),
      dateLabel: dateFormatter.format(post.data.pubDate),
    };
  });

const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const canonicalPath = getPath(`${lang}/blog/author/${author}/`);
const editorialPolicyPath = lang === 'de' ? getPath('de/blog/redaktionsrichtlinien') : getPath(`${getEditorialPolicyLang(lang)}/redaktionsrichtlinien/`);
const canonicalUrl = new URL(canonicalPath, siteUrl).href;

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': profile.entityType,
  name: profile.name,
  description: profile.bio,
  url: canonicalUrl,
};
---

<Layout
  title={`${profile.name} - ${t('blog.title')}`}
  description={profile.bio}
  canonical={canonicalPath}
  keywords={`${profile.name}, ${profile.role}, ${testNames[lang]}, Leben in Deutschland`}
  noindex={lang !== 'de'}
  disableAlternates={true}
  lang={lang}
>
  <Header lang={lang} disableAlternates={true} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(authorSchema)} />

  <main class="bg-slate-50 min-h-screen py-8 md:py-10">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm mb-6">
        <a href={getPath(`${lang}/blog`)} class="inline-flex items-center text-sm font-medium text-blue-700 hover:underline">
          ← {t('blog.back')}
        </a>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold text-slate-900 tracking-tight">{profile.name}</h1>
        <p class="mt-2 inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-700">
          {profile.role}
        </p>
        <p class="mt-4 text-slate-600 max-w-3xl">{profile.bio}</p>
        <a href={editorialPolicyPath} class="mt-4 inline-flex text-sm font-semibold text-blue-700 hover:underline">{labels.policy}</a>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {authorPosts.map((post) => (
          <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <a href={post.url} class="block">
              <div class="h-48 overflow-hidden bg-slate-100">
                <img
                  src={post.imageSrc}
                  srcset={post.srcset}
                  sizes={getOptimizedImageSizes()}
                  alt={post.imageAlt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                />
              </div>
              <div class="p-5">
                <p class="text-xs text-slate-500 mb-2">{post.dateLabel}</p>
                <h2 class="text-lg font-semibold text-slate-900 line-clamp-2 group-hover:text-blue-700 transition-colors mb-2">
                  {post.data.title}
                </h2>
                <p class="text-sm text-slate-600 line-clamp-3">{post.data.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
