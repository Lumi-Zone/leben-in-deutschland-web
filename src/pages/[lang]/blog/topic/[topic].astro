---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../../i18n/ui';
import { getPath } from '../../../../utils/navigation';
import {
  getBlogImageAlt,
  getOptimizedImageSizes,
  getOptimizedImageSrcset,
  getOptimizedImageUrl,
  normalizeKeyword,
  resolveBlogImage,
} from '../../../../utils/blog';

export async function getStaticPaths() {
  const supportedLangs = ['de', 'en', 'tr', 'ar', 'ua', 'ru', 'pl', 'fa', 'ps', 'ro', 'it', 'es'];
  const posts = await getCollection('blog');
  const topics = new Set<string>();

  posts.forEach((post) => {
    (post.data.tags ?? []).forEach((tag) => topics.add(normalizeKeyword(tag)));
  });

  return supportedLangs.flatMap((lang) =>
    Array.from(topics).map((topic) => ({ params: { lang, topic }, props: { lang, topic } }))
  );
}

const { lang, topic } = Astro.props;
const t = useTranslations(lang as any);
const posts = await getCollection('blog');

const localeByLang: Record<string, string> = {
  de: 'de-DE',
  en: 'en-US',
  tr: 'tr-TR',
  ar: 'ar',
  ua: 'uk-UA',
  ru: 'ru-RU',
  pl: 'pl-PL',
  fa: 'fa-IR',
  ps: 'ps',
  ro: 'ro-RO',
  it: 'it-IT',
  es: 'es-ES',
};
const locale = localeByLang[lang] || 'de-DE';
const dateFormatter = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' });

const allTopicLabels = new Map<string, string>();
posts.forEach((post) => {
  (post.data.tags ?? []).forEach((tag) => allTopicLabels.set(normalizeKeyword(tag), tag));
});

const topicLabel = allTopicLabels.get(topic) ?? topic;

const topicPosts = posts
  .filter((post) => (post.data.tags ?? []).map((tag) => normalizeKeyword(tag)).includes(topic))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => {
    const image = resolveBlogImage(post);
    return {
      ...post,
      image,
      imageAlt: getBlogImageAlt(post.data.title),
      srcset: getOptimizedImageSrcset(image),
      imageSrc: getOptimizedImageUrl(image, 1366),
      url: getPath(`${lang}/blog/${post.slug}`),
      dateLabel: dateFormatter.format(post.data.pubDate),
    };
  });

const siteUrl = Astro.site || 'https://lumi-zone.github.io';
const canonicalPath = getPath(`de/blog/topic/${topic}`);
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const isPrimaryBlogLocale = lang === 'de';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: new URL(getPath(`${lang}/`), siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('nav.blog'),
      item: new URL(getPath('de/blog'), siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: topicLabel,
      item: canonicalUrl,
    },
  ],
};
---

<Layout
  title={`${topicLabel} - ${t('blog.title')}`}
  description={`Alle Beiträge zum Thema ${topicLabel} rund um Einbürgerungstest und Leben in Deutschland.`}
  canonical={canonicalPath}
  keywords={`${topicLabel}, Einbürgerungstest, Leben in Deutschland, Blog`}
  noindex={!isPrimaryBlogLocale}
  disableAlternates={true}
  lang={lang}
>
  <Header lang={lang} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="bg-slate-50 min-h-screen py-8 md:py-10">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="mb-6 md:mb-8">
        <a href={getPath(`${lang}/blog`)} class="inline-flex items-center text-sm font-medium text-blue-700 hover:underline">
          ← {t('blog.back')}
        </a>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold text-slate-900 tracking-tight">{topicLabel}</h1>
        <p class="mt-3 text-slate-600">
          {topicPosts.length} Beiträge in dieser Kategorie.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {topicPosts.map((post) => (
          <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <a href={post.url} class="block">
              <div class="h-48 overflow-hidden bg-slate-100">
                <img
                  src={post.imageSrc}
                  srcset={post.srcset}
                  sizes={getOptimizedImageSizes()}
                  alt={post.imageAlt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                />
              </div>
              <div class="p-5">
                <p class="text-xs text-slate-500 mb-2">{post.dateLabel}</p>
                <h2 class="text-lg font-semibold text-slate-900 line-clamp-2 group-hover:text-blue-700 transition-colors mb-2">
                  {post.data.title}
                </h2>
                <p class="text-sm text-slate-600 line-clamp-3">{post.data.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
