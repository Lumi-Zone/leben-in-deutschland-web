---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../../i18n/ui';
import { getPath } from '../../../../utils/navigation';
import type { SupportedLang } from '../../../../types/language';
import { BLOG_TOPICS, BLOG_TOPIC_ALIASES, getBlogTopicBySlug, getLocalizedTopic } from '../../../../data/blogTopics';
import { blogCopy, blogLocales } from '../../../../i18n/blog';
import { testNames } from '../../../../i18n/seo';
import {
  getBlogImageAlt,
  getOptimizedImageSizes,
  getOptimizedImageSrcset,
  getOptimizedImageUrl,
} from '../../../../utils/blog';
import { getBlogLanguages, getPostImage, getRouteSlug, getTopicPosts } from '../../../../utils/blogTranslations';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return getBlogLanguages(posts).flatMap((lang) => [
    // German keeps every topic page; other languages only get topics they have guides for.
    ...BLOG_TOPICS.filter((topic) => lang === 'de' || getTopicPosts(posts, lang, topic.slug).length > 0).map((topic) => ({
      params: { lang, topic: topic.slug },
      props: { lang, topic: topic.slug },
    })),
    ...(lang === 'de' ? BLOG_TOPIC_ALIASES.map((alias) => ({
      params: { lang, topic: alias.slug },
      props: { lang, topic: alias.topicSlug },
    })) : []),
  ]);
}

const { lang, topic } = Astro.props as { lang: SupportedLang; topic: string };
const t = useTranslations(lang);
const posts = await getCollection('blog');

const locale = blogLocales[lang];
const dateFormatter = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' });

const baseTopic = getBlogTopicBySlug(topic);
if (!baseTopic) throw new Error(`Unknown blog topic: ${topic}`);
const topicData = getLocalizedTopic(baseTopic, lang);
const labels = blogCopy[lang];
const isLegacyTopicUrl = Astro.params.topic !== topicData.slug;

const topicPosts = getTopicPosts(posts, lang, topic)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id))
  .map((post) => {
    const image = getPostImage(post, posts);
    return {
      ...post,
      image,
      imageAlt: getBlogImageAlt(post.data.title),
      srcset: getOptimizedImageSrcset(image),
      imageSrc: getOptimizedImageUrl(image, 1366),
      url: getPath(`${lang}/blog/${getRouteSlug(post)}`),
      dateLabel: dateFormatter.format(post.data.pubDate),
    };
  });

const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const canonicalPath = getPath(`${lang}/blog/topic/${topic}/`);
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
// Only German topic pages are indexed (see the sitemap filter); translated ones stay crawlable navigation.
const noindex = lang !== 'de' || topicPosts.length < 2 || isLegacyTopicUrl;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: new URL(getPath(`${lang}/`), siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('nav.blog'),
      item: new URL(getPath(`${lang}/blog/`), siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: topicData.name,
      item: canonicalUrl,
    },
  ],
};
---

<Layout
  title={`${topicData.name} | ${labels.topicTitleSuffix}`}
  description={topicData.description}
  canonical={canonicalPath}
  keywords={`${topicData.name}, ${testNames[lang]}, Leben in Deutschland, Blog`}
  noindex={noindex}
  disableAlternates={true}
  lang={lang}
>
  <Header lang={lang} disableAlternates={true} />
  {isLegacyTopicUrl && (
    <script is:inline define:vars={{ targetUrl: canonicalUrl }}>
      window.location.replace(targetUrl);
    </script>
  )}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="bg-slate-50 min-h-screen py-8 md:py-10">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="mb-6 md:mb-8">
        <a href={getPath(`${lang}/blog`)} class="inline-flex items-center text-sm font-medium text-blue-700 hover:underline">
          ← {t('blog.back')}
        </a>
        <h1 class="mt-3 text-3xl md:text-5xl font-bold text-slate-900 tracking-tight">{topicData.name}</h1>
        <p class="mt-3 max-w-3xl text-slate-600">{topicData.description}</p>
        <p class="mt-3 text-slate-600">
          {labels.topicCount(topicPosts.length)}
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {topicPosts.map((post) => (
          <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <a href={post.url} class="block">
              <div class="h-48 overflow-hidden bg-slate-100">
                <img
                  src={post.imageSrc}
                  srcset={post.srcset}
                  sizes={getOptimizedImageSizes()}
                  alt={post.imageAlt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                />
              </div>
              <div class="p-5">
                <p class="text-xs text-slate-500 mb-2">{post.dateLabel}</p>
                <h2 class="text-lg font-semibold text-slate-900 line-clamp-2 group-hover:text-blue-700 transition-colors mb-2">
                  {post.data.title}
                </h2>
                <p class="text-sm text-slate-600 line-clamp-3">{post.data.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
