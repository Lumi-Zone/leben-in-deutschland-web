---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/ui';
import { getPath } from '../../../utils/navigation';
import type { SupportedLang } from '../../../types/language';
import Header from '../../../components/Header.astro';
import GuidePractice from '../../../components/GuidePractice.astro';
import BlogStudyPaths from '../../../components/BlogStudyPaths.astro';
import { getAuthorByName, getLocalizedAuthor } from '../../../data/blogAuthors';
import { blogCopy, blogLocales, getEditorialPolicyLang } from '../../../i18n/blog';
import { languages } from '../../../i18n/ui';
import { getPostImage, getPostTopics, getRouteSlug, getTranslations } from '../../../utils/blogTranslations';
import { getOfficialBlogSources } from '../../../data/blogSources';
import {
  getBlogImageAlt,
  getOptimizedImageSizes,
  getOptimizedImageSrcset,
  getOptimizedImageUrl,
  getReadingMinutes,
} from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: getRouteSlug(post) },
    props: { post, lang: post.data.lang as SupportedLang },
  }));
}

const { post } = Astro.props;
const lang = Astro.props.lang as SupportedLang;
const t = useTranslations(lang);
const { Content } = await post.render();
const allPosts = await getCollection('blog');
const allPostsSorted = allPosts.filter((entry) => entry.data.lang === lang).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id));

const currentTags = new Set(post.data.tags ?? []);
const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const routeSlug = getRouteSlug(post);
const canonicalPath = getPath(`${lang}/blog/${routeSlug}/`);
const canonicalPostUrl = new URL(canonicalPath, siteUrl).href;
const canonicalBlogIndexUrl = new URL(getPath(`${lang}/blog/`), siteUrl).href;
const translations = getTranslations(post, allPosts);
const translationLanguages = [lang, ...translations.map((entry) => entry.data.lang)];
const publishedIso = post.data.pubDate.toISOString();
const modifiedIso = (post.data.reviewedAt ?? post.data.updatedDate ?? post.data.pubDate).toISOString();
const readingMinutes = getReadingMinutes(post.body);
const wordCount = post.body.trim().split(/\s+/).filter(Boolean).length;
const image = getPostImage(post, allPosts);
const imageSrc = getOptimizedImageUrl(image, 1600);
const imageSrcset = getOptimizedImageSrcset(image);
const imageAlt = getBlogImageAlt(post.data.title);
const schemaImageUrl = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : new URL(getPath(image), siteUrl).href;
const keywords = post.data.tags ?? ['Einbürgerungstest', 'Leben in Deutschland'];
const postTopics = getPostTopics(post, allPosts, lang);
const officialSources = Array.from(new Map([
  ...(post.data.sources ?? []),
  ...getOfficialBlogSources(postTopics),
].map((source) => [source.url, source])).values()).slice(0, 6);
const editorialPolicyPath = getPath(`${getEditorialPolicyLang(lang)}/redaktionsrichtlinien/`);
const editorialPolicyUrl = new URL(editorialPolicyPath, siteUrl).href;
const authorProfile = getLocalizedAuthor(getAuthorByName(post.data.author), lang);
const authorPath = getPath(`${lang}/blog/author/${authorProfile.slug}`);

const locale = blogLocales[lang];
const dateFormatter = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long', day: 'numeric' });
const labels = blogCopy[lang];

const relatedPosts = allPosts
  .filter((entry) => entry.slug !== post.slug && entry.data.lang === lang)
  .sort((a, b) => {
    const aShared = (a.data.tags ?? []).filter((tag) => currentTags.has(tag)).length;
    const bShared = (b.data.tags ?? []).filter((tag) => currentTags.has(tag)).length;
    if (aShared !== bShared) return bShared - aShared;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3)
  .map((entry) => ({
    ...entry,
    image: getPostImage(entry, allPosts),
    dateLabel: dateFormatter.format(entry.data.pubDate),
    tags: entry.data.tags ?? [],
    url: getPath(`${lang}/blog/${getRouteSlug(entry)}`),
  }));

const currentIndex = allPostsSorted.findIndex((entry) => entry.slug === post.slug);
const newerPost = currentIndex > 0 ? allPostsSorted[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < allPostsSorted.length - 1 ? allPostsSorted[currentIndex + 1] : null;

const blogPostSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: lang,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  wordCount,
  url: canonicalPostUrl,
  mainEntityOfPage: canonicalPostUrl,
  image: [schemaImageUrl],
  author: {
    '@type': authorProfile.entityType,
    name: authorProfile.name,
    url: new URL(getPath(`${lang}/blog/author/${authorProfile.slug}/`), siteUrl).href,
  },
  articleSection: post.data.tags?.[0] ?? 'Blog',
  keywords: keywords.join(', '),
  citation: officialSources.map((source) => source.url),
  publisher: {
    '@type': 'Organization',
    name: 'Leben in Deutschland',
    logo: {
      '@type': 'ImageObject',
      url: new URL(getPath('logo.png'), siteUrl).href,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t('nav.home'),
      item: new URL(getPath(`${lang}/`), siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('nav.blog'),
      item: canonicalBlogIndexUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonicalPostUrl,
    },
  ],
};

---

<Layout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  canonical={canonicalPath}
  keywords={keywords.join(', ')}
  image={image}
  imageAlt={imageAlt}
  ogType="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  authors={[authorProfile.name]}
  disableAlternates={false}
  alternateLangs={translationLanguages}
  rssHref={getPath('rss.xml')}
  lang={lang}
>
  <Header lang={lang} alternateLangs={translationLanguages} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="min-h-screen bg-slate-50 py-8 md:py-10">
    <div class="container mx-auto px-4 max-w-5xl">
      <nav class="text-sm text-slate-500 mb-4 flex items-center gap-2 flex-wrap">
        <a href={getPath(`${lang}/`)} class="hover:text-blue-700 transition-colors">{t('nav.home')}</a>
        <span>/</span>
        <a href={getPath(`${lang}/blog`)} class="hover:text-blue-700 transition-colors">{t('nav.blog')}</a>
        <span>/</span>
        <span class="text-slate-700 line-clamp-1">{post.data.title}</span>
      </nav>

      <header class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6 md:mb-8">
        <div class="h-64 md:h-96 bg-slate-100">
          <img
            src={imageSrc}
            srcset={imageSrcset}
            sizes="100vw"
            alt={imageAlt}
            class="h-full w-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="p-6 md:p-8">
          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 mb-4">
            <time datetime={publishedIso}>{dateFormatter.format(post.data.pubDate)}</time>
            <span>•</span>
            <span>{readingMinutes} {labels.minutes}</span>
            <span>•</span>
            <a href={authorPath} class="hover:text-blue-700 transition-colors">{authorProfile.name}</a>
            <span>•</span>
            <span>{labels.updated}: {dateFormatter.format(post.data.reviewedAt ?? post.data.updatedDate ?? post.data.pubDate)}</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-slate-900 leading-tight mb-4">{post.data.title}</h1>
          <p class="text-base md:text-xl text-slate-600 leading-relaxed">{post.data.description}</p>
          {postTopics.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {postTopics.map((topic) => <a href={getPath(`${lang}/blog/topic/${topic.slug}`)} class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700 hover:border-blue-200 hover:text-blue-700 transition-colors">{topic.name}</a>)}
            </div>
          )}
          {translations.length > 0 && (
            <nav class="mt-5 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4 text-xs" aria-label={labels.availableIn} data-post-translations>
              <span class="font-semibold text-slate-600">{labels.availableIn}</span>
              {translations.map((entry) => {
                const hrefLang = entry.data.lang === 'ua' ? 'uk' : entry.data.lang;
                return <a href={getPath(`${entry.data.lang}/blog/${routeSlug}/`)} hreflang={hrefLang} lang={hrefLang} class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 font-semibold text-blue-800 hover:border-blue-300 transition-colors" data-umami-event="post-language-switch" data-umami-event-lang={entry.data.lang}>{languages[entry.data.lang]}</a>;
              })}
            </nav>
          )}
        </div>
      </header>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_280px]">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
          {post.data.practice && <GuidePractice guide={routeSlug} lang={lang} placement="top" practice={post.data.practice} />}
          <div lang={post.data.contentLang} dir={post.data.contentLang && ['ar', 'fa', 'ps'].includes(post.data.contentLang) ? 'rtl' : undefined} class="prose prose-lg max-w-none prose-headings:text-slate-900 prose-headings:font-bold prose-p:text-slate-700 prose-li:text-slate-700 prose-a:text-blue-700 prose-a:font-medium prose-a:no-underline hover:prose-a:underline">
            <Content />
          </div>
          {post.data.practice && <GuidePractice guide={routeSlug} lang={lang} placement="bottom" practice={post.data.practice} />}

          <section class="mt-10 rounded-xl border border-blue-100 bg-blue-50/70 p-5" aria-labelledby="official-sources-title">
            <h2 id="official-sources-title" class="text-lg font-bold text-slate-950">{labels.sources}</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              <time datetime={modifiedIso}>{dateFormatter.format(post.data.reviewedAt ?? post.data.updatedDate ?? post.data.pubDate)}</time>. {labels.sourceNote}
            </p>
            <ul class="mt-4 space-y-2 text-sm">
              {officialSources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-blue-700 hover:underline">
                    {source.name} ↗
                  </a>
                </li>
              ))}
            </ul>
            <a href={editorialPolicyUrl} class="mt-4 inline-flex text-sm font-semibold text-slate-700 hover:text-blue-700 hover:underline">
              {labels.policy}
            </a>
          </section>

          <div class="mt-10 pt-6 border-t border-slate-100 flex flex-wrap gap-3 justify-between items-center">
            <a
              href={getPath(`${lang}/blog`)}
              class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
            >
              {t('blog.back')}
            </a>
          </div>
        </div>

        <aside class="space-y-4">
          <BlogStudyPaths lang={lang} posts={allPosts} currentGuide={routeSlug} />
          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-bold uppercase tracking-wide text-slate-900 mb-2">{labels.author}</h2>
            <a href={authorPath} class="text-sm font-semibold text-slate-900 hover:text-blue-700 transition-colors">{authorProfile.name}</a>
            <p class="mt-1 text-xs text-slate-500">{authorProfile.role}</p>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">{authorProfile.bio}</p>
            <a href={editorialPolicyPath} class="mt-3 inline-flex text-xs font-semibold text-blue-700 hover:underline">{labels.policy}</a>
          </section>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-bold uppercase tracking-wide text-slate-900 mb-3">{labels.topics}</h2>
            <div class="flex flex-wrap gap-2">
              {postTopics.map((topic) => <a href={getPath(`${lang}/blog/topic/${topic.slug}`)} class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-medium text-slate-700 hover:border-blue-200 hover:text-blue-700 transition-colors">{topic.name}</a>)}
            </div>
          </section>

          {(newerPost || olderPost) && (
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <h2 class="text-sm font-bold uppercase tracking-wide text-slate-900 mb-3">{labels.more}</h2>
              <div class="space-y-3">
                {newerPost && (
                  <a href={getPath(`${lang}/blog/${getRouteSlug(newerPost)}`)} class="block rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 hover:bg-slate-100 transition-colors">
                    <p class="text-[11px] text-slate-500 mb-1">{labels.newer}</p>
                    <p class="text-sm font-medium text-slate-800 line-clamp-2">{newerPost.data.title}</p>
                  </a>
                )}
                {olderPost && (
                  <a href={getPath(`${lang}/blog/${getRouteSlug(olderPost)}`)} class="block rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 hover:bg-slate-100 transition-colors">
                    <p class="text-[11px] text-slate-500 mb-1">{labels.older}</p>
                    <p class="text-sm font-medium text-slate-800 line-clamp-2">{olderPost.data.title}</p>
                  </a>
                )}
              </div>
            </section>
          )}
        </aside>
      </div>

      {relatedPosts.length > 0 && (
        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 md:p-6 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 mb-4">{labels.related}</h2>
          <div class="grid gap-4 md:grid-cols-3">
            {relatedPosts.map((entry) => (
              <article class="rounded-xl border border-slate-200 overflow-hidden bg-white">
                <a href={entry.url} class="block group">
                  <div class="h-36 bg-slate-100 overflow-hidden">
                    <img
                      src={getOptimizedImageUrl(entry.image, 768)}
                      srcset={getOptimizedImageSrcset(entry.image)}
                      sizes={getOptimizedImageSizes()}
                      alt={getBlogImageAlt(entry.data.title)}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    />
                  </div>
                  <div class="p-4">
                    <p class="text-xs text-slate-500 mb-2">{entry.dateLabel}</p>
                    <h3 class="text-sm font-semibold text-slate-900 line-clamp-2 group-hover:text-blue-700 transition-colors mb-2">
                      {entry.data.title}
                    </h3>
                    <p class="text-xs text-slate-600 line-clamp-2">{entry.data.description}</p>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>
