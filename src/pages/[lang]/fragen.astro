---
import Layout from '../../layouts/Layout.astro';
import ExplainedQuestionPreview from '../../components/ExplainedQuestionPreview.astro';
import Header from '../../components/Header.astro';
import questions from '../../data/questions.json';
import { GERMAN_STATES, getStateDisplayName } from '../../data/germanStates';
import { getSeoLandingContent } from '../../data/seoLandingContent';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
import { useTranslations } from '../../i18n/ui';
import { searchCopy, QUESTION_SOURCE_URL } from '../../i18n/seo';
import { getLocalizedQuestionText } from '../../utils/questions';
import { getPath } from '../../utils/navigation';
import { getSeoLanguageMeta } from '../../utils/seo';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props as { lang: SupportedLang };
const copy = searchCopy[lang];
const t = useTranslations(lang);
const generalQuestions = questions.filter((question) => question.area_code !== 'land');
const groups = Array.from({ length: Math.ceil(generalQuestions.length / 50) }, (_, index) => generalQuestions.slice(index * 50, (index + 1) * 50));
const url = new URL(getPath(`${lang}/fragen/`), Astro.site).href;
const testGuide = getSeoLandingContent('einbuergerungstest-online', lang).copy;
const explanationPilot = {
  ar: {
    title: 'افهم الإجابات مع شرح بالعربية',
    description: 'تتضمن الأسئلة من 1 إلى 20 شرحًا مختصرًا وسبب صحة الإجابة. تعلّم المعنى بالعربية وراجع نص السؤال بالألمانية استعدادًا للاختبار.',
    start: 'ابدأ بالسؤال الأول مع الشرح',
    example: 'مثال: ما المقصود بحرية التنقل؟',
  },
  fa: {
    title: 'پاسخ‌ها را با توضیح فارسی بهتر بفهمید',
    description: 'پرسش‌های ۱ تا ۲۰ توضیح کوتاه و دلیل پاسخ درست دارند. مفهوم را به فارسی بیاموزید و برای آزمون، متن آلمانی پرسش را هم مرور کنید.',
    start: 'شروع از پرسش اول همراه با توضیح',
    example: 'نمونه: آزادی رفت‌وآمد یعنی چه؟',
  },
}[lang as 'ar' | 'fa'];
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  '@id': `${url}#collection`, url, name: copy.catalog, description: copy.description,
  inLanguage: getSeoLanguageMeta(lang).htmlLang,
  citation: QUESTION_SOURCE_URL,
  mainEntity: {
    '@type': 'ItemList', numberOfItems: generalQuestions.length,
    itemListElement: generalQuestions.map((question, index) => ({
      '@type': 'ListItem', position: index + 1,
      name: getLocalizedQuestionText(question, lang),
      url: new URL(getPath(`${lang}/frage/${question.id}/`), Astro.site).href,
    })),
  },
};
---
<Layout title={`${copy.catalog} | Leben in Deutschland`} description={copy.description} lang={lang} canonical={url} jsonLd={schema}>
  <Header lang={lang} />
  <main class="app-page">
    <div class="app-page-shell">
      <a href={getPath(`${lang}/`)} class="text-link">← {t('nav.home')}</a>
      <header class="premium-panel p-6 md:p-8 my-6">
        <h1 class="section-heading">{copy.catalog}</h1>
        <p class="section-subtitle mt-4">{copy.description}</p>
        <p class="mt-4">{copy.independence}</p>
        <a class="text-link inline-block mt-3" href={QUESTION_SOURCE_URL}>{copy.source} ↗</a>
        <p class="mt-4"><a class="text-link" href={getPath(`${lang}/einbuergerungstest-online/`)}>{testGuide.heading} →</a></p>
      </header>
      {explanationPilot && <section class="mb-6 border-s-4 border-emerald-300 ps-4" aria-labelledby="explanation-pilot-title">
        <h2 id="explanation-pilot-title" class="text-lg font-bold">{explanationPilot.title}</h2>
        <p class="mt-3 leading-relaxed">{explanationPilot.description}</p>
        <div class="mt-4 flex flex-wrap gap-4">
          <a class="text-link" href={getPath(`${lang}/frage/1/`)}>{explanationPilot.start} →</a>
          <a class="text-link" href={getPath(`${lang}/frage/19/`)}>{explanationPilot.example} →</a>
        </div>
      </section>}
      <ExplainedQuestionPreview lang={lang} />
      <nav aria-label={copy.catalog} class="catalog-nav flex flex-wrap gap-3 mb-8">
        {groups.map((group) => <a class="chip" href={`#fragen-${group[0].id}`}>{group[0].id}–{group[group.length - 1].id}</a>)}
        <a class="chip" href="#bundeslaender">{t('progress.topic_land')}</a>
      </nav>
      {groups.map((group) => <section id={`fragen-${group[0].id}`} class="mb-8 scroll-mt-24">
        <h2 class="text-2xl font-bold mb-4">{t('favorites.goto_question')} {group[0].id}–{group[group.length - 1].id}</h2>
        <ol start={group[0].id} class="catalog-list">
          {group.map((question) => <li><a href={getPath(`${lang}/frage/${question.id}/`)}>{getLocalizedQuestionText(question, lang)}</a></li>)}
        </ol>
      </section>)}
      <section id="bundeslaender" class="premium-panel p-6 md:p-8 scroll-mt-24" aria-labelledby="bundeslaender-title">
        <h2 id="bundeslaender-title" class="text-2xl font-bold mb-4">{t('progress.topic_land')}</h2>
        <div class="grid sm:grid-cols-2 gap-3">{GERMAN_STATES.map((state) => <a class="text-link" href={getPath(`${lang}/${state.slug}-fragen/`)}>{getStateDisplayName(state, lang)} →</a>)}</div>
      </section>
    </div>
  </main>
</Layout>
<style>
  .catalog-nav a { font-size: 1rem; min-height: 44px; }
  .catalog-list { list-style: decimal; padding-inline-start: 2.5rem; }
  .catalog-list li { padding: .8rem .5rem; border-bottom: 1px solid var(--line, #d6ded9); }
  .catalog-list a { display: block; color: var(--ink, #182d26); text-decoration: underline; text-underline-offset: .2em; line-height: 1.6; }
  .catalog-list a:hover { color: #27634b; }
</style>
