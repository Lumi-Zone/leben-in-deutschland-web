---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
import { getPath } from '../../utils/navigation';
import { APP_STORE_URL, PLAY_STORE_URL } from '../../utils/appLinks';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: SupportedLang };
const isGerman = lang === 'de';
const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const pageUrl = new URL(getPath(`${lang}/einbuergerungstest-online/`), siteUrl).href;
const homeUrl = new URL(getPath(`${lang}/`), siteUrl).href;
const questionUrl = getPath(`${lang}/frage/1`);
const examUrl = getPath(`${lang}/exam`);
const appUrl = getPath(`${lang}/app`);

const pageTitle = isGerman
  ? 'Einbürgerungstest online üben | Digitaler Test 2026'
  : 'Practice the Naturalization Test Online | Digital Test 2026';
const pageDescription = isGerman
  ? 'Einbürgerungstest online und digital üben: offizieller Fragenkatalog, Online-Test mit 33 Fragen, Prüfungssimulation und App für die Vorbereitung.'
  : 'Practice the German naturalization test online with official questions, digital exam simulation, and mobile app access.';
const pageKeywords = isGerman
  ? [
      'einbürgerungstest online',
      'einbürgerungstest digital',
      'einbürgerungstest online test',
      'einbürgerungstest online üben',
      'einbürgerungstest digital test',
      'einbürgerungstest 2026 online',
      'einbürgerungstest prüfung online',
      'bamf einbürgerungstest online',
    ].join(', ')
  : 'naturalization test online, digital test, German citizenship test, online practice';

const steps = isGerman
  ? [
      {
        title: '1. Fragen online lernen',
        text: 'Üben Sie die offiziellen Fragen Schritt für Schritt und markieren Sie schwierige Themen für später.',
      },
      {
        title: '2. Digitalen Test starten',
        text: 'Nutzen Sie die Prüfungssimulation mit 33 zufälligen Fragen und direkter Auswertung.',
      },
      {
        title: '3. Fehler wiederholen',
        text: 'Wiederholen Sie gezielt die Fragen, die noch unsicher sind, bis der Test sicher sitzt.',
      },
    ]
  : [
      {
        title: '1. Practice questions online',
        text: 'Work through official questions step by step and focus on difficult topics.',
      },
      {
        title: '2. Start digital test mode',
        text: 'Use exam simulation with 33 random questions and instant feedback.',
      },
      {
        title: '3. Review mistakes',
        text: 'Repeat the questions that still need practice until you feel confident.',
      },
    ];

const faqItems = isGerman
  ? [
      {
        question: 'Kann ich den Einbürgerungstest online üben?',
        answer: 'Ja. Sie können den Einbürgerungstest online mit offiziellen Fragen üben und anschließend eine digitale Prüfungssimulation starten.',
      },
      {
        question: 'Ist der Einbürgerungstest Online Test wie die echte Prüfung?',
        answer: 'Die Simulation hilft bei der Vorbereitung: 33 zufällige Fragen, direkte Auswertung und ein realistischer Testablauf.',
      },
      {
        question: 'Was bedeutet Einbürgerungstest digital?',
        answer: 'Digital bedeutet, dass Sie im Browser oder in der App üben, Fortschritt sehen und flexibel wiederholen können.',
      },
    ]
  : [
      {
        question: 'Can I practice the naturalization test online?',
        answer: 'Yes. You can practice official questions online and then start a digital exam simulation.',
      },
      {
        question: 'Is the online test like the real exam?',
        answer: 'The simulation supports exam preparation with 33 random questions and instant feedback.',
      },
      {
        question: 'What does digital naturalization test mean?',
        answer: 'It means browser-based or app-based practice with progress tracking and flexible review.',
      },
    ];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      name: pageTitle,
      description: pageDescription,
      url: pageUrl,
      inLanguage: lang,
    },
    {
      '@type': 'LearningResource',
      '@id': `${pageUrl}#learning-resource`,
      name: pageTitle,
      description: pageDescription,
      url: pageUrl,
      inLanguage: lang,
      learningResourceType: ['Practice test', 'Quiz', 'Exam simulation'],
      educationalLevel: 'adult education',
      teaches: isGerman
        ? ['Einbürgerungstest online', 'Einbürgerungstest digital', 'Einbürgerungstest online üben']
        : ['German naturalization test online', 'Digital exam preparation'],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Leben in Deutschland',
          item: homeUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: isGerman ? 'Einbürgerungstest online' : 'Online naturalization test',
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={getPath(`${lang}/einbuergerungstest-online/`)}
  image="/og/og-default.png"
  jsonLd={pageSchema}
  lang={lang}
>
  <Header lang={lang} />

  <main class="app-page">
    <section class="bg-slate-950 text-white">
      <div class="container mx-auto px-4 py-12 md:py-16">
        <div class="max-w-4xl">
          <p class="text-xs font-bold uppercase tracking-widest text-blue-200 mb-3">
            {isGerman ? 'Online-Test & Prüfungssimulation' : 'Online test and exam simulation'}
          </p>
          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight leading-tight mb-5">
            {isGerman ? 'Einbürgerungstest online üben' : 'Practice the naturalization test online'}
          </h1>
          <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-3xl mb-8">
            {isGerman
              ? 'Bereiten Sie sich digital auf den Einbürgerungstest vor: offizielle Fragen lernen, Online Test mit 33 Fragen simulieren und Fortschritt behalten.'
              : 'Prepare digitally for the German naturalization test with official questions, online test simulation, and progress tracking.'}
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={examUrl} class="inline-flex items-center justify-center rounded-lg bg-blue-500 px-5 py-3 font-bold text-white hover:bg-blue-400">
              {isGerman ? 'Online Test starten' : 'Start online test'}
            </a>
            <a href={questionUrl} class="inline-flex items-center justify-center rounded-lg bg-white px-5 py-3 font-bold text-slate-950 hover:bg-slate-100">
              {isGerman ? 'Fragen üben' : 'Practice questions'}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="grid gap-4 md:grid-cols-3">
          {steps.map((step) => (
            <article class="rounded-lg border border-slate-200 bg-slate-50 p-5">
              <h2 class="text-lg font-bold text-slate-950 mb-2">{step.title}</h2>
              <p class="text-sm leading-relaxed text-slate-600">{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
          <div class="max-w-3xl">
            <h2 class="text-3xl font-extrabold text-slate-950 mb-4">
              {isGerman ? 'Einbürgerungstest digital trainieren' : 'Train with a digital test'}
            </h2>
            <p class="text-slate-600 leading-relaxed mb-5">
              {isGerman
                ? 'Für Suchanfragen wie "einbürgerungstest online", "einbürgerungstest digital", "einbürgerungstest online test" und "einbürgerungstest online üben" ist diese Seite der direkte Einstieg. Sie können sofort mit den Fragen beginnen oder direkt in den Testmodus wechseln.'
                : 'This page gives you a direct path to practice questions, exam simulation, and mobile review.'}
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href={appUrl} class="inline-flex items-center justify-center rounded-xl bg-[#3f352c] px-5 py-3 font-bold text-white transition-colors hover:bg-[#2f2822]">
                {isGerman ? 'App herunterladen' : 'Download app'}
              </a>
              <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl border border-[#d5c7b6] bg-[#fffdf9] px-5 py-3 font-bold text-[#342b24] hover:bg-white">
                App Store
              </a>
              <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-xl border border-[#d5c7b6] bg-[#fffdf9] px-5 py-3 font-bold text-[#342b24] hover:bg-white">
                Google Play
              </a>
            </div>
          </div>

          <aside class="rounded-lg border border-blue-200 bg-blue-50 p-5">
            <h2 class="text-xl font-extrabold text-slate-950 mb-3">
              {isGerman ? 'Testmodus' : 'Test mode'}
            </h2>
            <ul class="space-y-2 text-sm text-slate-700">
              <li>{isGerman ? '33 zufällige Fragen' : '33 random questions'}</li>
              <li>{isGerman ? 'Direkte Auswertung' : 'Instant feedback'}</li>
              <li>{isGerman ? 'Wiederholung falscher Antworten' : 'Review wrong answers'}</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl">
          <h2 class="text-2xl font-extrabold text-slate-950 mb-5">FAQ</h2>
          <div class="space-y-3">
            {faqItems.map((item) => (
              <details class="rounded-lg border border-slate-200 bg-slate-50 p-5">
                <summary class="cursor-pointer text-base font-bold text-slate-950">{item.question}</summary>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
