---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getReviews } from '../../data/reviews';
import { useTranslations } from '../../i18n/ui';
import { getPath } from '../../utils/navigation';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
import {
  APP_STORE_URL,
  MOBILE_APP_ALTERNATE_NAMES,
  MOBILE_APP_NAME,
  PLAY_STORE_URL,
} from '../../utils/appLinks';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: SupportedLang };
const t = useTranslations(lang);
const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const appPageUrl = new URL(getPath(`${lang}/app/`), siteUrl).href;
const homeUrl = new URL(getPath(`${lang}/`), siteUrl).href;
const isGerman = lang === 'de';
const reviewsData = getReviews(lang).slice(0, 2);
const appDescription = isGerman
  ? 'Laden Sie die Leben in Deutschland App für iOS und Android herunter: 310 Fragen, Prüfungssimulation, Lernfortschritt und mehrsprachige Erklärungen.'
  : 'Download the Leben in Deutschland app for iOS and Android with 310 questions, exam simulation, learning progress, and multilingual explanations.';
const appTitle = isGerman
  ? 'Leben in Deutschland App für iOS & Android | Einbürgerungstest 2026'
  : 'Leben in Deutschland App for iOS & Android | Naturalization Test 2026';
const appKeywords = isGerman
  ? 'Leben in Deutschland App, Einbürgerungstest App, Leben in Deutschland 310Fragen, BAMF App, iOS, Android, Prüfungssimulation'
  : 'Leben in Deutschland app, naturalization test app, iOS, Android, exam simulation';
const screenshots = ['/mockups/m1.png', '/mockups/m2.png', '/mockups/m3.png'].map((path) =>
  new URL(getPath(path), siteUrl).href
);
const appReview = reviewsData[0];
const reviewSchema = appReview
  ? {
      '@type': 'Review',
      name: appReview.title,
      reviewBody: appReview.text,
      author: {
        '@type': 'Person',
        name: appReview.author,
      },
      reviewRating: {
        '@type': 'Rating',
        ratingValue: appReview.rating,
        bestRating: 5,
      },
    }
  : undefined;
const mobileAppSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${appPageUrl}#webpage`,
      name: appTitle,
      description: appDescription,
      url: appPageUrl,
      inLanguage: lang,
      primaryImageOfPage: screenshots[0],
      mainEntity: { '@id': `${appPageUrl}#mobile-app` },
    },
    {
      '@type': ['SoftwareApplication', 'MobileApplication'],
      '@id': `${appPageUrl}#mobile-app`,
      name: MOBILE_APP_NAME,
      alternateName: MOBILE_APP_ALTERNATE_NAMES,
      description: appDescription,
      applicationCategory: 'EducationalApplication',
      applicationSubCategory: 'Exam preparation',
      operatingSystem: 'iOS, Android',
      isAccessibleForFree: true,
      url: appPageUrl,
      installUrl: [APP_STORE_URL, PLAY_STORE_URL],
      downloadUrl: [APP_STORE_URL, PLAY_STORE_URL],
      sameAs: [APP_STORE_URL, PLAY_STORE_URL],
      screenshot: screenshots,
      offers: [
        {
          '@type': 'Offer',
          price: 0,
          priceCurrency: 'EUR',
          url: APP_STORE_URL,
          seller: {
            '@type': 'Organization',
            name: 'Apple App Store',
          },
        },
        {
          '@type': 'Offer',
          price: 0,
          priceCurrency: 'EUR',
          url: PLAY_STORE_URL,
          seller: {
            '@type': 'Organization',
            name: 'Google Play',
          },
        },
      ],
      ...(reviewSchema ? { review: reviewSchema } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${appPageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('nav.home'),
          item: homeUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: isGerman ? 'App' : t('question.practice_app'),
          item: appPageUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={appTitle}
  description={appDescription}
  keywords={appKeywords}
  canonical={getPath(`${lang}/app/`)}
  image="/og/og-default.png"
  jsonLd={mobileAppSchema}
  lang={lang}
>
  <Header lang={lang} />

  <main class="app-page">
    <section class="bg-white border-b border-slate-100">
      <div class="container mx-auto px-4 py-12 md:py-16">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center">
          <div>
            <a href={getPath(`${lang}/`)} class="inline-flex items-center rounded-xl border border-blue-200 bg-blue-50 px-3.5 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100 mb-6">
              ← {t('question.back')}
            </a>
            <p class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-3">
              iOS & Android
            </p>
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-950 mb-5">
              {isGerman ? 'Leben in Deutschland App herunterladen' : 'Download the Leben in Deutschland App'}
            </h1>
            <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mb-8">
              {appDescription}
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={APP_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="app-store-click"
                data-umami-event-location="app-page"
                data-umami-event-lang={lang}
                class="inline-flex items-center justify-center rounded-xl bg-slate-950 px-5 py-3 text-white font-bold hover:bg-slate-800 transition-colors"
              >
                App Store
              </a>
              <a
                href={PLAY_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="play-store-click"
                data-umami-event-location="app-page"
                data-umami-event-lang={lang}
                class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-white font-bold hover:bg-blue-700 transition-colors"
              >
                Google Play
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="grid grid-cols-3 gap-3 items-end">
              {screenshots.map((screenshot, index) => (
                <img
                  src={screenshot}
                  alt={`${MOBILE_APP_NAME} Screenshot ${index + 1}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class={`rounded-2xl border border-slate-200 bg-slate-100 shadow-lg ${index === 1 ? 'mb-8' : ''}`}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-slate-50">
      <div class="container mx-auto px-4">
        <div class="grid gap-4 md:grid-cols-3">
          {[
            {
              title: isGerman ? '310 offizielle Fragen' : '310 official questions',
              text: isGerman ? 'Alle allgemeinen BAMF-Fragen plus Bundesland-Fragen kompakt in einer App.' : 'All general questions plus state-specific questions in one compact app.',
            },
            {
              title: isGerman ? 'Prüfungssimulation' : 'Exam simulation',
              text: isGerman ? 'Üben Sie mit 33 zufälligen Fragen, Zeitlimit und direkter Auswertung.' : 'Practice with 33 random questions, a timer, and instant results.',
            },
            {
              title: isGerman ? 'Fortschritt behalten' : 'Track progress',
              text: isGerman ? 'Sehen Sie, welche Fragen sicher sitzen und welche Sie wiederholen sollten.' : 'See which questions you know well and which ones need another pass.',
            },
          ].map((feature) => (
            <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
              <h2 class="text-lg font-bold text-slate-950 mb-2">{feature.title}</h2>
              <p class="text-sm leading-relaxed text-slate-600">{feature.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {reviewsData.length > 0 && (
      <section class="py-12 md:py-16 bg-white">
        <div class="container mx-auto px-4">
          <div class="flex items-end justify-between gap-4 mb-6">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">
                Reviews
              </p>
              <h2 class="text-2xl md:text-3xl font-bold text-slate-950">
                {isGerman ? 'Was Nutzer über die App sagen' : 'What users say about the app'}
              </h2>
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            {reviewsData.map((review) => (
              <article class="rounded-lg border border-slate-200 bg-slate-50 p-5">
                <div class="text-yellow-500 text-sm mb-2">{'★'.repeat(review.rating)}</div>
                <h3 class="text-base font-bold text-slate-950 mb-2">{review.title}</h3>
                <p class="text-sm leading-relaxed text-slate-600 mb-4">{review.text}</p>
                <p class="text-xs font-semibold text-slate-500">{review.author}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>
