---
import Layout from '../../layouts/Layout.astro';
import questions from '../../data/questions.json';
import { useTranslations } from '../../i18n/ui';
import PhoneSlider from '../../components/PhoneSlider';
import ReviewsSlider from '../../components/ReviewsSlider';
import ContinueLearningCard from '../../components/ContinueLearningCard';
import OnboardingStarter from '../../components/OnboardingStarter';
import { getReviews } from '../../data/reviews';
import { GERMAN_STATES } from '../../data/germanStates';
import { getCollection } from 'astro:content';
import { getBlogImageAlt, getOptimizedImageUrl, resolveBlogImage } from '../../utils/blog';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
import { getLocalizedQuestionText } from '../../utils/questions';
import { stripHtml } from '../../utils/seo';
import { APP_STORE_URL, MOBILE_APP_ALTERNATE_NAMES, MOBILE_APP_NAME, PLAY_STORE_URL } from '../../utils/appLinks';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: SupportedLang };
const t = useTranslations(lang);
import Header from '../../components/Header.astro';
import { getPath } from '../../utils/navigation';

const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const homeUrl = new URL(getPath(`${lang}/`), siteUrl).href;
const primaryHomeUrl = new URL(getPath('de/'), siteUrl).href;
const organizationId = `${primaryHomeUrl}#organization`;
const websiteId = `${primaryHomeUrl}#website`;
const appId = `${primaryHomeUrl}#app`;
const reviewsData = getReviews(lang);
const heroDescription = stripHtml(t("hero.subtitle"));
const blogPosts = await getCollection('blog');
const recentBlogPosts = blogPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3)
	.map((post) => ({
		...post,
		image: resolveBlogImage(post),
		imageCard: getOptimizedImageUrl(resolveBlogImage(post), 768),
		imageAlt: getBlogImageAlt(post.data.title),
	}));
const stateLinks = GERMAN_STATES;
const isGerman = lang === 'de';
const seoTitle = isGerman
	? 'Einbürgerungstest 2026 online üben | Leben in Deutschland 300 Fragen'
	: `${t("hero.title")} 2026 - Official Questions and Exam Practice`;
const seoDescription = isGerman
	? 'Üben Sie den Leben in Deutschland Test 2026 kostenlos online: 300 offizielle BAMF-Fragen, Bundesland-Fragen, Prüfungssimulation und einfache Erklärungen.'
	: heroDescription;
const seoKeywords = isGerman
	? [
		'einbürgerungstest 2026 online üben',
		'leben in deutschland',
		'einbürgerung',
		'einbürgerungstest',
		'bamf',
		'300 fragen',
		'integrationskurs',
		'bundesland fragen',
		'bayern fragen',
		'berlin fragen',
		'hamburg fragen',
		'nordrhein-westfalen fragen',
		'politik kurs',
		'politikkurs',
		'orientierung',
		'orientierungskurs',
	  ].join(', ')
	: undefined;
const importantPages = [
	{
		label: isGerman ? 'Leben in Deutschland App' : t("question.practice_app"),
		description: isGerman ? 'Die App für iOS und Android mit Lernmodus, Prüfungssimulation und Fortschritt.' : t("features.exam.desc"),
		href: getPath(`${lang}/app`),
	},
	{
		label: isGerman ? 'Einbürgerungstest 2026 online üben' : t("home.start_quiz"),
		description: isGerman ? 'Alle 300 offiziellen BAMF-Fragen Schritt für Schritt trainieren.' : heroDescription,
		href: getPath(`${lang}/frage/1`),
	},
	{
		label: isGerman ? 'Prüfungssimulation mit 33 Fragen' : t("home.start_exam"),
		description: isGerman ? 'Den echten Testmodus mit zufälligen Fragen und Zeitlimit üben.' : t("features.exam.desc"),
		href: getPath(`${lang}/exam`),
	},
	{
		label: isGerman ? 'Bundesland-Fragen lernen' : `${t("progress.topic_land")} Fragen`,
		description: isGerman ? 'Die 10 Zusatzfragen für Berlin, Bayern, Hamburg und alle Bundesländer.' : heroDescription,
		href: getPath(`${lang}/berlin-fragen`),
	},
	{
		label: isGerman ? 'BAMF 300 Fragen & Erklärungen' : t("blog.title"),
		description: isGerman ? 'Ratgeber zu Einbürgerungstest, Leben in Deutschland Test und Prüfungsvorbereitung.' : t("blog.subtitle"),
		href: getPath(`${lang}/blog`),
	},
	{
		label: isGerman ? 'Hilfe & häufige Fragen' : t("nav.support"),
		description: isGerman ? 'Antworten zu App, Training, Anmeldung und Vorbereitung.' : t("support.subtitle"),
		href: getPath(`${lang}/support`),
	},
];
const organizationSchema = {
	'@type': 'Organization',
	'@id': organizationId,
	name: 'Leben in Deutschland',
	url: primaryHomeUrl,
	logo: new URL(getPath('logo.png'), siteUrl).href,
	sameAs: ['https://x.com/300Fragen'],
};
const websiteSchema = {
	'@type': 'WebSite',
	'@id': websiteId,
	name: 'Leben in Deutschland',
	alternateName: [
		'Leben in Deutschland Test',
		'Einbürgerungstest 2026',
		'LID Einbürgerung',
	],
	url: primaryHomeUrl,
	inLanguage: lang,
	description: seoDescription,
	publisher: { '@id': organizationId },
};
const appSchema = {
	'@type': 'SoftwareApplication',
	'@id': appId,
	name: MOBILE_APP_NAME,
	alternateName: MOBILE_APP_ALTERNATE_NAMES,
	applicationCategory: 'EducationalApplication',
	operatingSystem: 'iOS, Android',
	url: homeUrl,
	publisher: { '@id': organizationId },
	inLanguage: lang,
	description: seoDescription,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'EUR',
	},
	downloadUrl: [
		APP_STORE_URL,
		PLAY_STORE_URL,
	],
	sameAs: [APP_STORE_URL, PLAY_STORE_URL],
};
const stateListSchema = {
	'@type': 'ItemList',
	'@id': `${homeUrl}#bundesland-fragen`,
	name: 'Bundesland Fragen',
	itemListElement: stateLinks.map((state, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: `${state.name} Fragen`,
		url: new URL(getPath(`${lang}/${state.slug}-fragen/`), siteUrl).href,
	})),
};
const sitelinksSchema = {
	'@type': 'ItemList',
	'@id': `${homeUrl}#wichtige-seiten`,
	name: 'Wichtige Seiten',
	itemListElement: importantPages.map((page, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: page.label,
		description: page.description,
		url: new URL(page.href, siteUrl).href,
	})),
};
const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${homeUrl}#breadcrumb`,
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Leben in Deutschland',
			item: homeUrl,
		},
	],
};
const homeSchemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [organizationSchema, websiteSchema, appSchema, stateListSchema, sitelinksSchema, breadcrumbSchema],
};
---

<Layout
	title={seoTitle}
	description={seoDescription}
	keywords={seoKeywords}
	image="/logo.png"
	canonical={getPath(`${lang}/`)}
	jsonLd={homeSchemaGraph}
	lang={lang}
>
	<!-- Navigation -->
	<Header lang={lang} />

	<main class="app-page">
		<!-- HERO SECTION -->
		<div class="container mx-auto px-4 py-10 lg:py-14 text-center relative">
			<div class="absolute inset-x-4 top-8 h-44 bg-gradient-to-r from-blue-100/45 via-transparent to-amber-100/45 blur-3xl pointer-events-none" aria-hidden="true"></div>
			<div class="inline-flex items-center gap-3 bg-yellow-50 border border-yellow-200 px-6 py-2.5 rounded-full mb-7 shadow-sm transition-transform hover:scale-105 cursor-default">
				<span class="text-sm font-bold uppercase tracking-widest text-yellow-900">{t("hero.badge")}</span>
				<div class="flex text-yellow-500 text-base">★★★★★</div>
				<span class="text-base font-extrabold text-gray-900">4.8</span>
			</div>
			
			<h1 class="text-5xl lg:text-7xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-600 mb-6 tracking-tight">
				{t("hero.title")}
			</h1>
			
			<p class="text-xl text-gray-600 max-w-2xl mx-auto mb-7 leading-relaxed" set:html={t("hero.subtitle")}>
			</p>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 lg:mb-14">
				<a
					href={APP_STORE_URL}
					data-umami-event="app-store-click"
					data-umami-event-location="home-hero"
					data-umami-event-lang={lang}
					class="bg-black text-white px-6 py-3 rounded-xl flex items-center gap-3 hover:bg-gray-800 transition-all transform hover:scale-105 shadow-xl border border-gray-800 group"
				>
					<svg class="w-8 h-8 group-hover:opacity-90 transition-opacity" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M16.365 1.43c0 1.14-.41 1.99-1.01 2.72-.63.77-1.66 1.36-2.67 1.28-.13-1.06.3-2.06.9-2.75.62-.71 1.7-1.22 2.78-1.25zM19.46 17.03c-.41.94-.61 1.36-1.14 2.21-.74 1.19-1.78 2.67-3.07 2.68-1.15.01-1.45-.75-3.01-.74-1.56.01-1.89.75-3.03.74-1.29-.01-2.29-1.34-3.03-2.53-2.07-3.35-2.28-7.28-1.01-9.24.9-1.39 2.33-2.2 3.67-2.2 1.37 0 2.23.76 3.37.76 1.11 0 1.78-.76 3.36-.76 1.2 0 2.47.65 3.37 1.78-2.96 1.62-2.47 5.85.52 7.3z"/>
					</svg>
					<div class="text-left">
						<div class="text-[10px] font-medium opacity-80 uppercase leading-none mb-1">{t("hero.download_apple")}</div>
						<div class="text-lg font-bold leading-none -mt-0.5 font-sans">App Store</div>
					</div>
				</a>
				<a
					href={PLAY_STORE_URL}
					data-umami-event="play-store-click"
					data-umami-event-location="home-hero"
					data-umami-event-lang={lang}
					class="bg-black text-white px-6 py-3 rounded-xl flex items-center gap-3 hover:bg-gray-800 transition-all transform hover:scale-105 shadow-xl border border-gray-800 group"
				>
					<svg class="w-7 h-7 group-hover:opacity-90 transition-opacity" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M3 2.5L14.5 12L3 21.5V2.5Z" fill="white"/>
						<path d="M14.5 12L18.2 8.9L21 10.5C21.7 10.9 21.7 11.9 21 12.3L18.2 13.9L14.5 12Z" fill="white" fill-opacity="0.85"/>
						<path d="M14.5 12L18.2 15.1L8.3 20.7L3 21.5L14.5 12Z" fill="white" fill-opacity="0.72"/>
						<path d="M14.5 12L8.3 3.3L3 2.5L14.5 12Z" fill="white" fill-opacity="0.62"/>
					</svg>
					<div class="text-left">
						<div class="text-[10px] font-medium opacity-80 uppercase leading-none mb-1">{t("hero.download_google")}</div>
						<div class="text-lg font-bold leading-none -mt-0.5 font-sans">Google Play</div>
					</div>
				</a>
			</div>

			<!-- Phone Mockup Carousel -->
			<div class="mb-12 lg:mb-14">
				<PhoneSlider client:visible lang={lang} />
			</div>
		</div>

		<OnboardingStarter
			client:visible
			lang={lang}
			labels={{
				title: t("home.continue_title"),
				subtitle: t("home.continue_subtitle"),
				learn: t("home.start_quiz"),
				exam: t("home.start_exam"),
				progress: t("home.progress_cta"),
				continueLearn: t("home.continue_cta"),
				dismiss: t("nav.close_menu"),
			}}
		/>

		<!-- SAMPLE QUESTIONS SECTION -->
		<section id="beispiel-fragen" class="py-14 md:py-16 bg-white/70">
			<div class="container mx-auto px-4">
				<div class="max-w-6xl mx-auto">
					<div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-8">
						<div class="text-left">
							<div class="inline-flex items-center rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-bold uppercase tracking-widest text-blue-700 mb-4">
								BAMF 2026
							</div>
							<h2 class="text-2xl md:text-3xl font-bold text-gray-900">
								{t("home.sample_questions")} ({questions.length})
							</h2>
							<p class="text-sm md:text-base text-gray-600 mt-2 max-w-2xl">
								{heroDescription}
							</p>
						</div>
						<div class="flex flex-col sm:flex-row gap-3">
							<a
								href={getPath(`${lang}/frage/1`)}
								data-umami-event="start-quiz-click"
								data-umami-event-location="sample-questions"
								data-umami-event-lang={lang}
								class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl border border-blue-200 text-blue-700 bg-blue-50 hover:bg-blue-100 font-semibold transition-colors"
							>
								{t("home.start_quiz")} →
							</a>
							<a
								href={getPath(`${lang}/exam`)}
								data-umami-event="start-exam-click"
								data-umami-event-location="sample-questions"
								data-umami-event-lang={lang}
								class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-blue-600 text-white hover:bg-blue-700 font-semibold transition-colors shadow-sm"
							>
								{t("home.start_exam")}
							</a>
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{questions.slice(0, 6).map((q) => {
							const qTitle = getLocalizedQuestionText(q, lang);
							return (
								<a
									href={getPath(`${lang}/frage/${q.id}`)}
									data-umami-event="sample-question-opened"
									data-umami-event-lang={lang}
									data-umami-event-question-id={q.id}
									class="block group"
								>
									<div class="bg-white p-5 rounded-2xl border border-gray-100 hover:border-blue-500 hover:shadow-lg transition-all h-full flex flex-col group-hover:-translate-y-1">
										<div class="flex items-center justify-between mb-3 gap-3">
											<span class="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md">#{q.id}</span>
											<span class="text-[10px] font-semibold text-gray-500 uppercase tracking-wide bg-gray-50 px-2 py-1 rounded text-right line-clamp-1">{q.area}</span>
										</div>
										<h3 class="text-base font-medium text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-3 leading-relaxed">
											{qTitle}
										</h3>
									</div>
								</a>
							);
						})}
					</div>

					<div class="mt-8 flex flex-col sm:flex-row justify-center items-center gap-3">
						<a
							href={getPath(`${lang}/favorites`)}
							data-umami-event="favorites-opened"
							data-umami-event-location="home"
							data-umami-event-lang={lang}
							class="inline-flex items-center px-5 py-2.5 rounded-xl border border-amber-200 text-amber-700 bg-amber-50 hover:bg-amber-100 font-semibold transition-colors"
						>
							{t("home.favorites_cta")}
						</a>
						<a
							href={getPath(`${lang}/progress`)}
							data-umami-event="progress-opened"
							data-umami-event-location="home"
							data-umami-event-lang={lang}
							class="inline-flex items-center px-5 py-2.5 rounded-xl border border-emerald-200 text-emerald-700 bg-emerald-50 hover:bg-emerald-100 font-semibold transition-colors"
						>
							{t("home.progress_cta")}
						</a>
					</div>
				</div>
			</div>
		</section>

		<ContinueLearningCard
			client:visible
			lang={lang}
			totalQuestions={questions.length}
			labels={{
				title: t("home.continue_title"),
				subtitle: t("home.continue_subtitle"),
				continueCta: t("home.continue_cta"),
				startCta: t("home.continue_start"),
				solvedLabel: t("home.continue_solved"),
				lastLabel: t("home.continue_last"),
				noProgress: t("home.continue_no_progress"),
			}}
		/>

		<section id="wichtige-seiten" class="py-12 md:py-14 bg-slate-50/80">
			<div class="container mx-auto px-4">
				<div class="max-w-6xl mx-auto">
					<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
						<div>
							<p class="text-xs font-bold uppercase tracking-widest text-blue-700 mb-2">
								Leben in Deutschland 2026
							</p>
							<h2 class="text-2xl md:text-3xl font-bold text-gray-900">
								{isGerman ? 'Direkt zum Einbürgerungstest üben' : t("features.title")}
							</h2>
						</div>
						<p class="text-sm md:text-base text-gray-600 max-w-2xl">
							{isGerman
								? 'Die wichtigsten Bereiche der Vorbereitung sind hier direkt verlinkt, damit Sie schneller zur passenden Übung finden.'
								: heroDescription}
						</p>
					</div>

					<nav aria-label={isGerman ? 'Wichtige Seiten' : 'Important pages'} class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
						{importantPages.map((page) => (
							<a
								href={page.href}
								class="group rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-colors hover:border-blue-200 hover:bg-blue-50/60"
							>
								<span class="block text-sm font-bold text-gray-900 group-hover:text-blue-700">{page.label}</span>
								<span class="mt-2 block text-xs leading-relaxed text-gray-600">{page.description}</span>
							</a>
						))}
					</nav>
				</div>
			</div>
		</section>

		<section id="bundesland-fragen" class="py-14 md:py-16">
			<div class="container mx-auto px-4">
				<div class="rounded-3xl border border-blue-100 bg-gradient-to-b from-blue-50/70 to-white p-6 md:p-8 shadow-sm">
					<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
						<h2 class="text-2xl md:text-3xl font-bold text-gray-900">
							{t("progress.topic_land")} · 16
						</h2>
						<a
							href={getPath(`${lang}/berlin-fragen`)}
							data-umami-event="state-section-start-click"
							data-umami-event-lang={lang}
							data-umami-event-state="Berlin"
							class="inline-flex items-center w-fit px-4 py-2 rounded-xl border border-blue-200 text-blue-700 bg-blue-50 hover:bg-blue-100 transition-colors font-semibold"
						>
							{t("home.start_quiz")} →
						</a>
					</div>
					<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
						{stateLinks.map((state) => (
							<a
								href={getPath(`${lang}/${state.slug}-fragen`)}
								data-umami-event="state-page-opened"
								data-umami-event-lang={lang}
								data-umami-event-state={state.name}
								class="group rounded-xl border border-white/80 bg-white/85 px-3.5 py-3 text-sm font-medium text-gray-700 hover:text-blue-700 hover:border-blue-200 hover:bg-blue-50/70 transition-all shadow-[0_8px_20px_-18px_rgba(15,23,42,0.5)]"
							>
								<span class="inline-flex items-center gap-1.5">
									<span class="text-blue-300 group-hover:text-blue-500 transition-colors">•</span>
									{state.name}
								</span>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="pb-14 md:pb-16">
			<div class="container mx-auto px-4">
				<div class="flex items-center justify-between mb-6 gap-4">
					<div>
						<h2 class="text-2xl md:text-3xl font-bold text-gray-900">{t("blog.title")}</h2>
						<p class="text-sm md:text-base text-gray-600 mt-1">{t("blog.subtitle")}</p>
					</div>
					<a
						href={getPath(`${lang}/blog`)}
						data-umami-event="blog-opened"
						data-umami-event-location="home-section"
						data-umami-event-lang={lang}
						class="inline-flex items-center rounded-xl border border-blue-200 bg-blue-50 px-4 py-2.5 text-sm font-semibold text-blue-700 hover:bg-blue-100 transition-colors"
					>
						{t("nav.blog")} →
					</a>
				</div>

					<div class="grid gap-4 md:grid-cols-3">
						{recentBlogPosts.map((post) => (
							<article class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm hover:shadow-md transition-shadow h-full flex flex-col">
								<div class="h-36 rounded-xl overflow-hidden bg-slate-100 mb-4">
									<img
										src={post.imageCard}
										alt={post.imageAlt}
										loading="lazy"
										decoding="async"
										class="h-full w-full object-cover"
									/>
								</div>
								<div class="text-xs text-gray-500 mb-2">{post.data.pubDate.toLocaleDateString(lang)}</div>
								<h4 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">{post.data.title}</h4>
								<p class="text-sm text-gray-600 line-clamp-3 mb-4 flex-1">{post.data.description}</p>
								<a
									href={getPath(`${lang}/blog/${post.slug}`)}
									data-umami-event="blog-post-opened"
									data-umami-event-location="home-section"
									data-umami-event-lang={lang}
									data-umami-event-slug={post.slug}
									class="inline-flex items-center text-sm font-semibold text-blue-700 hover:underline"
								>
									{t("blog.read_more")}
								</a>
							</article>
						))}
					</div>
				</div>
			</section>

		<!-- REVIEWS SECTION -->
		<ReviewsSlider client:visible lang={lang} reviewsData={reviewsData} />

		<!-- FOOTER -->
		<footer class="bg-white border-t border-gray-100 py-12">
			<div class="container mx-auto px-4 text-center">
				<div class="flex flex-col md:flex-row justify-center items-center gap-8 text-sm text-gray-500 mb-8">
