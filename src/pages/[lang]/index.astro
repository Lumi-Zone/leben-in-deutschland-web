---
import Layout from '../../layouts/Layout.astro';
import questions from '../../data/questions.json';
import { useTranslations } from '../../i18n/ui';
import { searchCopy, QUESTION_SOURCE_URL } from '../../i18n/seo';
import HomePractice from '../../components/HomePractice';
import { buildQuestionSessionItem } from '../../utils/questions';
import PhoneSlider from '../../components/PhoneSlider';
import AppInstallQr from '../../components/AppInstallQr.astro';
import ReviewsSlider from '../../components/ReviewsSlider';
import ContinueLearningCard from '../../components/ContinueLearningCard';
import OnboardingStarter from '../../components/OnboardingStarter';
import { getReviews } from '../../data/reviews';
import { GERMAN_STATES } from '../../data/germanStates';
import { getCollection } from 'astro:content';
import { getBlogImageAlt, getOptimizedImageUrl, resolveBlogImage } from '../../utils/blog';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
import { getLocalizedQuestionText } from '../../utils/questions';
import { stripHtml } from '../../utils/seo';
import { APP_STORE_URL, MOBILE_APP_ALTERNATE_NAMES, MOBILE_APP_NAME, PLAY_STORE_URL, buildStoreUrls } from '../../utils/appLinks';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: SupportedLang };
const t = useTranslations(lang);
import Header from '../../components/Header.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { SOCIAL_PROFILE_URLS } from '../../utils/social';
import { getPath } from '../../utils/navigation';

const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const homeUrl = new URL(getPath(`${lang}/`), siteUrl).href;
const primaryHomeUrl = new URL(getPath('de/'), siteUrl).href;
const organizationId = `${primaryHomeUrl}#organization`;
const websiteId = `${primaryHomeUrl}#website`;
const appId = `${primaryHomeUrl}#app`;
const reviewsData = getReviews(lang);
const heroDescription = stripHtml(t("hero.subtitle"));
const blogPosts = await getCollection('blog');
const recentBlogPosts = blogPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3)
	.map((post) => ({
		...post,
		image: resolveBlogImage(post),
		imageCard: getOptimizedImageUrl(resolveBlogImage(post), 768),
		imageAlt: getBlogImageAlt(post.data.title),
	}));
const stateLinks = GERMAN_STATES;
const isGerman = lang === 'de';
const homeStore = buildStoreUrls({ source: 'home-app', lang });
const seoTitle = isGerman
	? 'Einbürgerungstest 2026 online üben | Leben in Deutschland 300 Fragen'
	: `${t("hero.title")} | ${searchCopy[lang].catalog}`;
const seoDescription = isGerman
	? 'Üben Sie den Leben in Deutschland Test 2026 kostenlos online: 300 offizielle BAMF-Fragen, Bundesland-Fragen, Prüfungssimulation und einfache Erklärungen.'
	: heroDescription;
const seoKeywords = isGerman
	? [
		'einbürgerungstest 2026 online üben',
		'leben in deutschland online',
		'leben in deutschland digital',
		'leben in deutschland online test',
		'leben in deutschland online test üben',
		'leben in deutschland digital test',
		'einbürgerungstest online',
		'einbürgerungstest digital',
		'einbürgerungstest online test',
		'einbürgerungstest online üben',
		'leben in deutschland',
		'einbürgerung',
		'einbürgerungstest',
		'bamf',
		'300 fragen',
		'integrationskurs',
		'bundesland fragen',
		'bayern fragen',
		'berlin fragen',
		'hamburg fragen',
		'nordrhein-westfalen fragen',
		'politik kurs',
		'politikkurs',
		'orientierung',
		'orientierungskurs',
	  ].join(', ')
	: undefined;
const importantPages = [
	{
		label: searchCopy[lang].catalog,
		description: searchCopy[lang].description,
		href: getPath(`${lang}/fragen/`),
	},
	{
		label: isGerman ? 'Leben in Deutschland App' : t("question.practice_app"),
		description: isGerman ? 'Die App für iOS und Android mit Lernmodus, Prüfungssimulation und Fortschritt.' : t("features.exam.desc"),
		href: getPath(`${lang}/app`),
	},
	{
		label: isGerman ? 'Einbürgerungstest 2026 online üben' : t("home.start_quiz"),
		description: isGerman ? 'Alle 300 offiziellen BAMF-Fragen Schritt für Schritt trainieren.' : heroDescription,
		href: getPath(`${lang}/frage/1`),
	},
	{
		label: isGerman ? 'Leben in Deutschland online' : 'Online practice',
		description: isGerman ? 'Digital lernen, Online-Test üben und direkt zur Prüfungssimulation wechseln.' : heroDescription,
		href: getPath(`${lang}/leben-in-deutschland-online`),
	},
	{
		label: isGerman ? 'Einbürgerungstest online üben' : 'Online naturalization test',
		description: isGerman ? 'Einbürgerungstest digital trainieren: Fragen, Testmodus und App.' : t("features.exam.desc"),
		href: getPath(`${lang}/einbuergerungstest-online`),
	},
	{
		label: isGerman ? 'Prüfungssimulation mit 33 Fragen' : t("home.start_exam"),
		description: isGerman ? 'Den echten Testmodus mit zufälligen Fragen und Zeitlimit üben.' : t("features.exam.desc"),
		href: getPath(`${lang}/exam`),
	},
	{
		label: isGerman ? 'Bundesland-Fragen lernen' : `${t("progress.topic_land")} Fragen`,
		description: isGerman ? 'Die 10 Zusatzfragen für Berlin, Bayern, Hamburg und alle Bundesländer.' : heroDescription,
		href: getPath(`${lang}/berlin-fragen`),
	},
	{
		label: isGerman ? 'BAMF 300 Fragen & Erklärungen' : t("blog.title"),
		description: isGerman ? 'Ratgeber zu Einbürgerungstest, Leben in Deutschland Test und Prüfungsvorbereitung.' : t("blog.subtitle"),
		href: getPath('de/blog'),
	},
	{
		label: isGerman ? 'Hilfe & häufige Fragen' : t("nav.support"),
		description: isGerman ? 'Antworten zu App, Training, Anmeldung und Vorbereitung.' : t("support.subtitle"),
		href: getPath(`${lang}/support`),
	},
];
const organizationSchema = {
	'@type': 'Organization',
	'@id': organizationId,
	name: 'Leben in Deutschland',
	url: primaryHomeUrl,
	logo: new URL(getPath('logo.png'), siteUrl).href,
	sameAs: SOCIAL_PROFILE_URLS,
};
const websiteSchema = {
	'@type': 'WebSite',
	'@id': websiteId,
	name: 'Leben in Deutschland',
	alternateName: [
		'Leben in Deutschland Test',
		'Einbürgerungstest 2026',
		'LID Einbürgerung',
		'Leben in Deutschland online',
		'Einbürgerungstest online',
		'Einbürgerungstest digital',
	],
	url: primaryHomeUrl,
	inLanguage: lang,
	description: seoDescription,
	publisher: { '@id': organizationId },
};
const appSchema = {
	'@type': 'SoftwareApplication',
	'@id': appId,
	name: MOBILE_APP_NAME,
	alternateName: MOBILE_APP_ALTERNATE_NAMES,
	applicationCategory: 'EducationalApplication',
	operatingSystem: 'iOS, Android',
	url: homeUrl,
	publisher: { '@id': organizationId },
	inLanguage: lang,
	description: seoDescription,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'EUR',
	},
	downloadUrl: [
		APP_STORE_URL,
		PLAY_STORE_URL,
	],
	sameAs: [APP_STORE_URL, PLAY_STORE_URL],
};
const stateListSchema = {
	'@type': 'ItemList',
	'@id': `${homeUrl}#bundesland-fragen`,
	name: 'Bundesland Fragen',
	itemListElement: stateLinks.map((state, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: `${state.name} Fragen`,
		url: new URL(getPath(`${lang}/${state.slug}-fragen/`), siteUrl).href,
	})),
};
const sitelinksSchema = {
	'@type': 'ItemList',
	'@id': `${homeUrl}#wichtige-seiten`,
	name: 'Wichtige Seiten',
	itemListElement: importantPages.map((page, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: page.label,
		description: page.description,
		url: new URL(page.href, siteUrl).href,
	})),
};
const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${homeUrl}#breadcrumb`,
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Leben in Deutschland',
			item: homeUrl,
		},
	],
};
const homeSchemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [organizationSchema, websiteSchema, appSchema, stateListSchema, sitelinksSchema, breadcrumbSchema],
};
---

<Layout
	title={seoTitle}
	description={seoDescription}
	keywords={seoKeywords}
	image="/logo.png"
	canonical={getPath(`${lang}/`)}
	jsonLd={homeSchemaGraph}
	lang={lang}
>
	<!-- Navigation -->
	<Header lang={lang} />

	<main class="home-page">
        <section class="home-hero home-shell">
            <div>
                <p class="home-eyebrow"><i aria-hidden="true"></i>Einbürgerungstest · 2026</p>
                <h1>{isGerman ? <>Dein nächstes<br/>Kapitel <em>beginnt<br/>hier.</em></> : lang === 'tr' ? <>Yeni bir hayat.<br/><em>İlk adım burada.</em></> : lang === 'en' ? <>Your next chapter<br/><em>starts here.</em></> : t('hero.title')}</h1>
                <p class="home-description">{isGerman ? 'Mach Deutschland zu deinem Zuhause. Bereite dich mit allen offiziellen Fragen auf deinen Einbürgerungstest vor – in deinem Tempo, in deiner Sprache.' : lang === 'tr' ? 'Almanya’yı evin yap. Tüm resmî sorularla vatandaşlık sınavına kendi hızında, kendi dilinde hazırlan.' : lang === 'en' ? 'Make Germany your home. Prepare for your citizenship test with all official questions, at your pace and in your language.' : heroDescription}</p>
                <div class="home-actions">
                    <a class="home-button" href={getPath(`${lang}/frage/1`)} data-umami-event="start-quiz-click" data-umami-event-location="home-hero" data-umami-event-lang={lang}>{t('home.start_quiz')} <span aria-hidden="true">↗</span></a>
                    <a class="home-button secondary" href={getPath(`${lang}/exam`)} data-umami-event="start-exam-click" data-umami-event-location="home-hero" data-umami-event-lang={lang}>{t('features.exam.title')} <span aria-hidden="true">→</span></a>
                </div>
                <div class="home-trust"><span><b aria-hidden="true">✓</b>{isGerman ? 'Kostenlos online lernen' : lang === 'tr' ? 'Ücretsiz çevrimiçi öğren' : 'Free online practice'}</span><span><b aria-hidden="true">✓</b>{isGerman ? 'Ohne Anmeldung' : lang === 'tr' ? 'Kayıt gerektirmez' : 'No account needed'}</span></div>
            </div>
            <HomePractice client:load lang={lang} question={buildQuestionSessionItem(questions[0], lang)} labels={{title:t('features.practice.title'),correct:t('question.correct'),wrong:t('question.wrong'),answer:t('question.correct_answer'),next:t('home.continue_cta')}} />
        </section>
        <div class="home-stats home-shell">
            <div class="home-stat"><strong>300</strong><span>{isGerman ? 'Offizielle' : lang === 'tr' ? 'Resmî' : 'Official'}<br/>{isGerman ? 'BAMF-Fragen' : lang === 'tr' ? 'BAMF sorusu' : 'BAMF questions'}</span></div>
            <div class="home-stat"><strong>16</strong><span>{t('progress.topic_land')}</span></div>
            <div class="home-stat"><strong>{SUPPORTED_LANGUAGES.length}</strong><span>{isGerman ? 'Sprachen.' : lang === 'tr' ? 'Dil.' : 'Languages.'}<br/>{isGerman ? 'Ein Ziel.' : lang === 'tr' ? 'Tek hedef.' : 'One goal.'}</span></div>
            <div class="home-stat"><strong>33</strong><span>{isGerman ? 'Fragen pro' : lang === 'tr' ? 'Deneme sınavı' : 'Questions per'}<br/>{isGerman ? 'Probeprüfung' : lang === 'tr' ? 'sorusu' : 'practice exam'}</span></div>
        </div>

        <section class="home-section home-shell" id="wichtige-seiten">
            <div class="home-section-head">
                <div><p class="home-eyebrow">{t('features.badge')}</p><h2>{isGerman ? <>Ein Ziel. Dein eigener Weg.</> : t('features.title')}</h2></div>
                <p>{isGerman ? 'Ob erste Frage oder letzte Generalprobe: Finde den Lernmodus, der gerade zu dir passt.' : t('features.practice.desc')}</p>
            </div>
            <div class="home-modes">
                {[
                    {n:'01',icon:'learn',title:t('features.learn.title'),description:t('features.learn.desc'),href:getPath(`${lang}/frage/1`),label:t('home.start_quiz'),meta:isGerman ? '300 FRAGEN · SCHRITT FÜR SCHRITT' : '300 · BAMF'},
                    {n:'02',icon:'exam',title:t('features.exam.title'),description:t('features.exam.desc'),href:getPath(`${lang}/exam`),label:t('home.start_exam'),meta:isGerman ? '33 FRAGEN · 60 MINUTEN' : '33 · 60 MIN'},
                    {n:'03',icon:'progress',title:t('home.progress_cta'),description:t('home.continue_subtitle'),href:getPath(`${lang}/progress`),label:t('home.progress_cta'),meta:isGerman ? 'DEIN FORTSCHRITT IM BLICK' : t('home.continue_title')},
                ].map((mode) => <a class={`home-mode ${mode.icon}`} href={mode.href}>
                    <div class="mode-top"><span class="mode-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">{mode.icon === 'learn' ? <><path d="M12 6c-3-2-6-2-9-1v14c3-1 6-1 9 1 3-2 6-2 9-1V5c-3-1-6-1-9 1Z"/><path d="M12 6v14"/></> : mode.icon === 'exam' ? <><circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M9 2h6M12 2v3"/></> : <><path d="M4 20h16M6 16v-4M12 16V8M18 16V4"/></>}</svg></span><span class="mode-number">{mode.n}</span></div>
                    <p class="mode-meta">{mode.meta}</p><h3>{mode.title}</h3><p class="mode-description">{mode.description}</p><span class="mode-link">{mode.label}<span aria-hidden="true">↗</span></span>
                </a>)}
            </div>
        </section>

        <section class="home-section home-shell" id="beispiel-fragen">
            <div class="home-section-head"><div><p class="home-eyebrow">{isGerman ? 'KLEINE SCHRITTE. ECHTER FORTSCHRITT.' : t('home.start_quiz')}</p><h2>{t('home.sample_questions')}</h2></div><a class="home-text-link" href={getPath(`${lang}/frage/1`)}>{t('home.start_quiz')} <span aria-hidden="true">→</span></a></div>
            <div class="home-questions">
                {questions.slice(0,6).map((q)=><a class="home-question" href={getPath(`${lang}/frage/${q.id}`)} data-umami-event="sample-question-opened" data-umami-event-lang={lang} data-umami-event-question-id={q.id}>
                    <div class="question-meta"><span>{String(q.id).padStart(2,'0')}</span><span>{q.area}</span><span aria-hidden="true">↗</span></div><h3>{getLocalizedQuestionText(q,lang)}</h3>
                </a>)}
            </div>
            <div class="home-question-links"><a class="home-text-link" href={getPath(`${lang}/fragen/`)}>{searchCopy[lang].catalog} →</a><a class="home-text-link" href={getPath(`${lang}/favorites`)}>♡ {t('home.favorites_cta')}</a><a class="home-text-link" href={getPath(`${lang}/focus`)}>{t('features.practice.title')} →</a></div>
        </section>

        <section class="home-section home-shell" id="bundesland-fragen">
            <div class="home-states">
                <div class="home-section-head"><div><p class="home-eyebrow">16 BUNDESLÄNDER</p><h2>{isGerman ? <>Dein Zuhause.<br/>Deine Fragen.</> : t('progress.topic_land')}</h2></div><p>{isGerman ? 'Berlin, Bayern oder irgendwo dazwischen? Lerne die 10 Zusatzfragen für das Bundesland, in dem du lebst.' : lang === 'tr' ? 'Yaşadığın eyaleti seç ve sınavda çıkacak 10 ek soruya hazırlan.' : lang === 'en' ? 'Choose where you live and prepare for your state’s 10 additional questions.' : t('features.learn.desc')}</p></div>
                <div class="home-state-grid">{stateLinks.map((state)=><a href={getPath(`${lang}/${state.slug}-fragen`)} data-umami-event="state-page-opened" data-umami-event-state={state.name} data-umami-event-lang={lang}><span>{state.name}</span><span aria-hidden="true">↗</span></a>)}</div>
            </div>
        </section>

        <div class="home-learning home-shell">
            <ContinueLearningCard client:visible lang={lang} totalQuestions={questions.length} labels={{title:t('home.continue_title'),subtitle:t('home.continue_subtitle'),continueCta:t('home.continue_cta'),startCta:t('home.continue_start'),solvedLabel:t('home.continue_solved'),lastLabel:t('home.continue_last'),noProgress:t('home.continue_no_progress')}} />
            <OnboardingStarter client:visible lang={lang} labels={{title:t('features.badge'),subtitle:t('features.title'),learn:t('home.start_quiz'),exam:t('home.start_exam'),progress:t('home.progress_cta'),continueLearn:t('home.continue_cta'),dismiss:t('nav.close_menu')}} />
        </div>

        <section class="home-section home-shell home-mobile-app" id="app">
            <PhoneSlider client:visible lang={lang} />
            <div class="home-app-downloads"><p>{isGerman ? 'Dein Lernbegleiter. Immer dabei.' : t('question.practice_app')}</p><div class="home-actions"><a class="home-button" href={homeStore.ios} data-umami-event="app-store-click" data-umami-event-location="home-app" data-umami-event-lang={lang}>App Store <span aria-hidden="true">↗</span></a><a class="home-button secondary" href={homeStore.android} data-umami-event="play-store-click" data-umami-event-location="home-app" data-umami-event-lang={lang}>Google Play <span aria-hidden="true">↗</span></a></div><AppInstallQr lang={lang} placement="home-qr" /></div>
        </section>

        <section class="home-section home-shell home-blog">
            <div class="home-section-head"><div><p class="home-eyebrow">{t('nav.blog')}</p><h2>{isGerman ? 'Gut vorbereitet. Gut informiert.' : t('blog.title')}</h2></div><a class="home-text-link" href={getPath('de/blog')}>{t('nav.blog')} <span aria-hidden="true">→</span></a></div>
            <div class="home-blog-grid">{recentBlogPosts.map((post)=><article><a href={getPath(`de/blog/${post.slug}`)} data-umami-event="blog-post-opened" data-umami-event-location="home-section" data-umami-event-lang={lang} data-umami-event-slug={post.slug}><div class="home-blog-image"><img src={post.imageCard} alt={post.imageAlt} width="768" height="480" loading="lazy" decoding="async"/></div><p class="home-blog-date">{post.data.pubDate.toLocaleDateString(lang)}</p><h3>{post.data.title}</h3><p class="home-blog-description">{post.data.description}</p><span class="home-text-link">{t('blog.read_more')} <span aria-hidden="true">↗</span></span></a></article>)}</div>
        </section>

        <div class="home-reviews"><ReviewsSlider client:visible lang={lang} reviewsData={reviewsData}/></div>

        <section class="home-resources home-shell"><h2>{isGerman ? 'Alles für deine Vorbereitung' : t('features.title')}</h2><nav aria-label={isGerman ? 'Wichtige Seiten' : 'Resources'}>{importantPages.map((page)=><a href={page.href}>{page.label}<span aria-hidden="true">↗</span></a>)}</nav><p class="mt-6">{searchCopy[lang].independence}</p><p class="mt-3"><a class="home-text-link" href={QUESTION_SOURCE_URL}>{searchCopy[lang].source} ↗</a></p><p class="mt-3"><a class="home-text-link" href={getPath('de/blog/redaktionsrichtlinien/')} lang="de">Redaktionsrichtlinien & Quellen →</a></p></section>

        <footer class="home-footer"><div class="home-shell"><div class="home-footer-top"><a class="home-footer-brand" href={getPath(`${lang}/`)}><img src={getPath('logo.svg')} width="36" height="36" alt=""/><span>Leben in<br/>Deutschland<span class="footer-brand-dot">.</span></span></a><p>{isGerman ? 'Dein nächstes Kapitel beginnt mit einer Frage.' : t('hero.title')}</p><a class="home-text-link" href={getPath(`${lang}/frage/1`)}>{t('home.start_quiz')} ↗</a></div><div class="home-footer-bottom"><p>© {new Date().getFullYear()} Leben in Deutschland</p><nav aria-label={t('nav.imprint')}>{[['terms-of-service',t('nav.tos')],['datenschutz',t('nav.privacy')],['impressum',t('nav.imprint')],['subscription-terms',t('nav.subscription')],['support',t('nav.support')]].map(([path,label])=><a href={getPath(`${lang}/${path}`)}>{label}</a>)}</nav><div class="home-footer-social"><span>{t('social.follow')}</span><SocialLinks location="footer" lang={lang} /></div></div></div></footer>
    </main>
</Layout>
