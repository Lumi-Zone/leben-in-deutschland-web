---
import Layout from '../../../layouts/Layout.astro';
import QuestionCard from '../../../components/QuestionCard';
import Header from '../../../components/Header.astro';
import questions from '../../../data/questions.json';
import { useTranslations } from '../../../i18n/ui';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../../types/language';
import { getPath } from '../../../utils/navigation';
import {
  buildQuestionTranslations,
  getQuestionImagePath,
  parseCorrectIndex,
  type QuestionTranslationContent,
} from '../../../utils/questions';
import { truncateText } from '../../../utils/seo';

interface QuestionPageProps {
  question: {
    id: number;
    imagePath: string | null;
    correct_index: number;
    area: string;
    area_code: string;
    thema: string;
    translations: { de: QuestionTranslationContent } & Partial<Record<SupportedLang, QuestionTranslationContent>>;
    prevId: number | null;
    nextId: number | null;
    position: number;
    total: number;
  };
  lang: SupportedLang;
}

// Full i18n getStaticPaths
export function getStaticPaths() {
  // Create flat array of all paths
  const paths: Array<{
    params: { lang: SupportedLang; id: string };
    props: QuestionPageProps;
  }> = [];

  SUPPORTED_LANGUAGES.forEach((lang) => {
    questions.forEach((q, index) => {
      const correctIndex = parseCorrectIndex(q.solution || '');
      const translations = buildQuestionTranslations(q, lang);

      const prevId = index > 0 ? questions[index - 1].id : null;
      const nextId = index < questions.length - 1 ? questions[index + 1].id : null;

      paths.push({
        params: { lang, id: q.id.toString() },
        props: { 
          question: {
              id: q.id,
              imagePath: getQuestionImagePath(q),
              correct_index: correctIndex,
              area: q.area,
              area_code: q.area_code,
              thema: q.thema,
              translations,
              prevId,
              nextId,
              position: index + 1,
              total: questions.length,
          },
          lang
        },
      });
    });
  });

  return paths;
}

const { question, lang } = Astro.props as QuestionPageProps;

// Schema.org JSON-LD localizing
const currentContent = question.translations[lang] || question.translations.de;
const translate = useTranslations(lang);
const questionLabel = `${translate("favorites.goto_question")} ${question.id}`;
const questionText = currentContent.question.replace(/\s+/g, ' ').trim();
const pageTitleQuestion = truncateText(questionText, 72);
const pageTitle = `${questionLabel}: ${pageTitleQuestion} | Einbürgerungstest 2026`;
const schema = {
  "@context": "https://schema.org/",
  "@type": "Quiz",
  "name": `Leben in Deutschland ${questionLabel} (${lang.toUpperCase()})`,
  "url": new URL(getPath(`${lang}/frage/${question.id}/`), Astro.site || 'https://lid-einbuergerung.de').href,
  "inLanguage": lang,
  "about": [question.area, question.thema].filter(Boolean),
  "mainEntity": {
    "@type": "Question",
    "name": currentContent.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": currentContent.options[question.correct_index]
    },
    "suggestedAnswer": currentContent.options.map((opt: string, idx: number) => ({
      "@type": "Answer",
      "text": opt,
      "position": idx + 1
    }))
  }
};

const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const questionUrl = new URL(getPath(`${lang}/frage/${question.id}/`), siteUrl).href;
const questionPreview = truncateText(questionText, 145);
const pageDescription = `${translate("hero.title")} ${questionLabel}: ${questionPreview} Online üben mit Antwortauswahl und direkter Kontrolle.`;
const pageKeywords = [
  `${translate("hero.title")} ${questionLabel}`,
  'Einbürgerungstest 2026',
  'Leben in Deutschland Fragen',
  question.area,
  question.thema,
].filter(Boolean).join(', ');

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": translate("nav.home"),
      "item": new URL(getPath(`${lang}/`), siteUrl).href
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": questionLabel,
      "item": questionUrl
    }
  ]
};
const learningResourceSchema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": pageTitle,
  "description": pageDescription,
  "url": questionUrl,
  "inLanguage": lang,
  "learningResourceType": "Quiz",
  "educationalLevel": "adult education",
  "about": [question.area, question.thema].filter(Boolean)
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={getPath(`${lang}/frage/${question.id}/`)}
  image="/logo.png"
  ogType="article"
  jsonLd={[schema, breadcrumbSchema, learningResourceSchema]}
  prevHref={question.prevId ? getPath(`${lang}/frage/${question.prevId}/`) : undefined}
  nextHref={question.nextId ? getPath(`${lang}/frage/${question.nextId}/`) : undefined}
  lang={lang}
>
  <Header lang={lang} />
  <main class="app-page">
    <div class="app-page-shell">
      <div class="max-w-5xl mx-auto mb-6 flex flex-wrap gap-2.5">
        <a href={getPath(`${lang}/`)} data-umami-event="question-toolbar-click" data-umami-event-destination="home" data-umami-event-lang={lang} class="inline-flex items-center rounded-xl border border-blue-200 bg-blue-50 px-3.5 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100">← {translate("question.back")}</a>
        <a href={getPath(`${lang}/exam`)} data-umami-event="start-exam-click" data-umami-event-location="question-toolbar" data-umami-event-lang={lang} class="inline-flex items-center rounded-xl border border-indigo-200 bg-indigo-50 px-3.5 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-100">{translate("home.start_exam")}</a>
        <a href={getPath(`${lang}/favorites`)} data-umami-event="favorites-opened" data-umami-event-location="question-toolbar" data-umami-event-lang={lang} class="inline-flex items-center rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-100">{translate("nav.favorites")}</a>
        <a href={getPath(`${lang}/progress`)} data-umami-event="progress-opened" data-umami-event-location="question-toolbar" data-umami-event-lang={lang} class="inline-flex items-center rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-100">{translate("nav.progress")}</a>
        <a href={getPath(`${lang}/focus`)} data-umami-event="focus-practice-opened" data-umami-event-location="question-toolbar" data-umami-event-lang={lang} class="inline-flex items-center rounded-xl border border-cyan-200 bg-cyan-50 px-3.5 py-2 text-sm font-semibold text-cyan-700 hover:bg-cyan-100">{translate("progress.focus_cta")}</a>
      </div>

      <QuestionCard 
        client:load 
        id={question.id} 
        imagePath={question.imagePath}
        data={question.translations}
        correctIndex={question.correct_index}
        prevId={question.prevId}
        nextId={question.nextId}
        initialLang={lang}
        practiceAppLabel={translate("question.practice_app")}
        resultCorrectLabel={translate("question.correct")}
        resultWrongLabel={translate("question.wrong")}
        correctAnswerLabel={translate("question.correct_answer")}
        prevLabel={translate("question.prev")}
        nextLabel={translate("question.next")}
        questionPosition={question.position}
        questionTotal={question.total}
        progressLabel={translate("question.progress")}
        favoriteAddLabel={translate("question.favorite_add")}
        favoriteRemoveLabel={translate("question.favorite_remove")}
        shortcutsLabel={translate("question.shortcuts_title")}
        shortcutSelectLabel={translate("question.shortcuts_select")}
        shortcutPrevLabel={translate("question.shortcuts_prev")}
        shortcutNextLabel={translate("question.shortcuts_next")}
        shortcutFavoriteLabel={translate("question.shortcuts_favorite")}
        jumpToLabel={translate("question.jump_label")}
        jumpPlaceholder={translate("question.jump_placeholder")}
        jumpButtonLabel={translate("question.jump_button")}
        jumpErrorLabel={translate("question.jump_error")}
      />
      
      <div class="mt-10 text-center text-slate-400 text-sm">
        <p>Leben in Deutschland &copy; {new Date().getFullYear()}</p>
      </div>
    </div>
  </main>
</Layout>
