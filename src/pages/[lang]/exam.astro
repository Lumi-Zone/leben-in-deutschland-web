---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ExamSimulator from '../../components/ExamSimulator';
import questions from '../../data/questions.json';
import { useTranslations } from '../../i18n/ui';
import { getPath } from '../../utils/navigation';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
import { buildQuestionSessionPool } from '../../utils/questions';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: SupportedLang };
const t = useTranslations(lang);
const examPool = buildQuestionSessionPool(questions, lang);
const siteUrl = Astro.site || 'https://lid-einbuergerung.de';
const examUrl = new URL(getPath(`${lang}/exam/`), siteUrl).href;
const isGerman = lang === 'de';
const examTitle = isGerman
  ? 'Einbürgerungstest Prüfungssimulation 2026 | 33 Fragen online üben'
  : `${t("exam.title")} | ${t("hero.title")}`;
const examDescription = isGerman
  ? 'Starten Sie eine realistische Einbürgerungstest Prüfungssimulation mit 33 zufälligen Fragen, Zeitlimit und direkter Auswertung.'
  : t("exam.subtitle");
const examHeading = isGerman
  ? 'Einbürgerungstest Prüfungssimulation: 33 Fragen online üben'
  : `${t("exam.title")}: ${t("hero.title")}`;
const examKeywords = isGerman
  ? 'Einbürgerungstest Prüfungssimulation, Leben in Deutschland Test Simulation, 33 Fragen, BAMF Test online, Prüfung üben'
  : `${t("exam.title")}, ${t("hero.title")}, exam simulation`;
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": examTitle,
  "description": examDescription,
  "url": examUrl,
  "inLanguage": lang,
};
const learningResourceSchema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": examTitle,
  "description": examDescription,
  "url": examUrl,
  "inLanguage": lang,
  "learningResourceType": "Practice test",
  "educationalLevel": "adult education",
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t("nav.home"),
      "item": new URL(getPath(`${lang}/`), siteUrl).href,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t("exam.title"),
      "item": examUrl,
    },
  ],
};
---

<Layout
  title={examTitle}
  description={examDescription}
  keywords={examKeywords}
  canonical={getPath(`${lang}/exam/`)}
  image="/logo.png"
  jsonLd={[webPageSchema, learningResourceSchema, breadcrumbSchema]}
  lang={lang}
>
  <Header lang={lang} />

  <main class="app-page">
    <div class="app-page-shell">
      <header class="max-w-5xl mx-auto mb-8">
        <a href={getPath(`${lang}/`)} class="inline-flex items-center rounded-xl border border-blue-200 bg-blue-50 px-3.5 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-100">← {t("question.back")}</a>

        <div class="mt-6 max-w-3xl">
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-blue-700">BAMF 2026 · 33 Fragen</p>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 md:text-5xl">
            {examHeading}
          </h1>
          <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
            {examDescription}
          </p>
          <nav class="mt-5 flex flex-wrap gap-3 text-sm font-semibold" aria-label={t("exam.title")}>
            <a class="text-blue-700 hover:underline" href={getPath(`${lang}/frage/1`)}>
              {t("home.start_quiz")} →
            </a>
            <a class="text-blue-700 hover:underline" href={getPath(`${lang}/einbuergerungstest-online`)}>
              {isGerman ? 'Einbürgerungstest online üben' : t("exam.title")} →
            </a>
          </nav>
        </div>
      </header>

      <ExamSimulator
        client:visible
        lang={lang}
        pool={examPool}
        labels={{
          title: t("exam.title"),
          subtitle: t("exam.subtitle"),
          start: t("exam.start"),
          timer: t("exam.timer"),
          progress: t("exam.progress"),
          previous: t("exam.previous"),
          next: t("exam.next"),
          finish: t("exam.finish"),
          answered: t("exam.answered"),
          resultTitle: t("exam.result_title"),
          passed: t("exam.passed"),
          failed: t("exam.failed"),
          score: t("exam.score"),
          passRule: t("exam.pass_rule"),
          wrongAnswers: t("exam.wrong_answers"),
          reviewQuestion: t("exam.review_question"),
          restart: t("exam.restart"),
          noQuestions: t("exam.no_questions"),
          noWrongAnswers: t("exam.no_wrong_answers"),
        }}
      />
    </div>
  </main>
</Layout>
