---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FocusPracticeSession from '../../components/FocusPracticeSession';
import questions from '../../data/questions.json';
import { useTranslations } from '../../i18n/ui';
import { getPath } from '../../utils/navigation';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../../types/language';
import { buildQuestionSessionPool } from '../../utils/questions';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: SupportedLang };
const t = useTranslations(lang);
const pool = buildQuestionSessionPool(questions, lang);
---

<Layout
  title={`${t("focus.page_title")} - ${t("hero.title")}`}
  description={t("focus.subtitle")}
  image="/logo.png"
  noindex={true}
  disableAlternates={true}
  lang={lang}
>
  <Header lang={lang} />

  <main class="app-page">
    <div class="app-page-shell">
      <div class="max-w-5xl mx-auto mb-6 flex flex-wrap gap-2.5 text-sm">
        <a href={getPath(`${lang}/`)} class="inline-flex items-center rounded-xl border border-blue-200 bg-blue-50 px-3.5 py-2 font-semibold text-blue-700 hover:bg-blue-100">← {t("question.back")}</a>
        <a href={getPath(`${lang}/progress`)} class="inline-flex items-center rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 font-semibold text-emerald-700 hover:bg-emerald-100">{t("nav.progress")}</a>
      </div>

      <FocusPracticeSession
        client:visible
        lang={lang}
        pool={pool}
        labels={{
          title: t("focus.title"),
          subtitle: t("focus.subtitle"),
          start: t("focus.start"),
          empty: t("focus.empty"),
          questions: t("focus.questions"),
          answered: t("focus.answered"),
          previous: t("focus.previous"),
          next: t("focus.next"),
          finish: t("focus.finish"),
          resultTitle: t("focus.result_title"),
          score: t("focus.score"),
          restart: t("focus.restart"),
          reviewQuestion: t("focus.review_question"),
          correct: t("focus.correct"),
          wrong: t("focus.wrong"),
          correctAnswer: t("focus.correct_answer"),
        }}
      />
    </div>
  </main>
</Layout>
