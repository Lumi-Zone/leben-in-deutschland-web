---
// Root redirect
const base = import.meta.env.BASE_URL;
// Ensure we don't end up with //de/ if base is / (though unlikely in this config)
// Actually standard join is safer:
const redirectUrl = base.endsWith('/') ? `${base}de/` : `${base}/de/`;
const canonicalUrl = new URL(redirectUrl, Astro.site || 'https://lid-einbuergerung.de').href;
---

<!doctype html>
<html lang="de-DE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Leben in Deutschland</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
    <script is:inline define:vars={{ redirectUrl }}>
      window.location.href = redirectUrl;
    </script>
  </head>
  <body>
    <a href={redirectUrl}>Weiter zu Leben in Deutschland</a>
  </body>
</html>
