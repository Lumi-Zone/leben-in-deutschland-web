---
import { renderQrSvg } from '../utils/qrcode';
import { useTranslations } from '../i18n/ui';
import { getPath } from '../utils/navigation';
import type { SupportedLang } from '../types/language';

interface Props {
  lang: SupportedLang;
  /** Distinguishes several codes on one page in the analytics campaign token. */
  placement?: string;
  class?: string;
}

const { lang, placement = 'desktop-qr', class: className } = Astro.props;
const t = useTranslations(lang);

const siteUrl = Astro.site ?? new URL('https://lid-einbuergerung.de');

// The code cannot branch on the scanner's platform, so it points at the app page
// rather than a single store. That page offers both stores and, thanks to the
// `src` marker, re-tags its store links so a scan-driven install stays
// attributable to this placement.
const target = new URL(getPath(`${lang}/app/`), siteUrl);
target.searchParams.set('src', placement);

const svg = renderQrSvg(target.href, {
  title: t('qr.title'),
  dark: '#2f2822',
  light: '#fffdf9',
});
---

<aside class:list={['install-qr', className]} data-qr-target={target.href}>
  <div class="install-qr-code" set:html={svg} />
  <div class="install-qr-copy">
    <p class="install-qr-title">{t('qr.title')}</p>
    <p class="install-qr-hint">{t('qr.hint')}</p>
  </div>
</aside>

<style>
  /* Desktop-only: on a phone the visitor can simply tap a store button, and a
     code they cannot scan with the device they are holding is just clutter. */
  .install-qr {
    display: none;
  }

  @media (min-width: 768px) {
    .install-qr {
      display: flex;
      align-items: center;
      gap: 1rem;
      max-width: 26rem;
      padding: 0.875rem 1rem;
      border: 1px solid #ded2c4;
      border-radius: 1rem;
      background: #fffdf9;
      box-shadow: 0 18px 34px -30px rgba(57, 43, 31, 0.65);
    }
  }

  .install-qr-code {
    flex-shrink: 0;
    /* 128px across 41 modules leaves roughly 3 device pixels per module, which
       phone cameras scan reliably at arm's length. Smaller starts to fail. */
    width: 8rem;
    height: 8rem;
    /* Rounding stays well inside the four-module quiet zone. */
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .install-qr-code :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .install-qr-title {
    margin: 0;
    font-weight: 700;
    font-size: 0.9375rem;
    color: #302821;
  }

  .install-qr-hint {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #6d6258;
  }
</style>
