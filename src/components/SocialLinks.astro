---
import { SOCIAL_PROFILES } from '../utils/social';

interface Props {
  /** Where on the site the row is rendered — kept as an analytics dimension. */
  location: string;
  lang: string;
  class?: string;
}

const { location, lang, class: className } = Astro.props;
---

<ul class:list={['social-links', className]}>
  {SOCIAL_PROFILES.map((profile) => (
    <li>
      <a
        href={profile.url}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label={profile.label}
        title={profile.label}
        data-umami-event="social-link-click"
        data-umami-event-platform={profile.platform}
        data-umami-event-location={location}
        data-umami-event-lang={lang}
      >
        {profile.platform === 'instagram' && (
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        )}
        {profile.platform === 'facebook' && (
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M17.5 2.5h-2.75a4.75 4.75 0 0 0-4.75 4.75V10.5H7v4h3v7h4v-7h3l1-4h-4V7.25c0-.55.45-1 1-1h2.5z" />
          </svg>
        )}
        {profile.platform === 'x' && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: inherit;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>
