---
import { getPath } from '../utils/navigation';
import { getQuestionExplanation } from '../data/questionExplanations';
import { buildQuestionSessionItem, type QuestionRecord } from '../utils/questions';
import { BAMF_TEST_SOURCE, BAMF_QUESTION_CATALOG } from '../data/seoLandingContent';

interface Props { stateSlug: string; stateName: string; questions: QuestionRecord[] }
const { stateSlug, stateName, questions } = Astro.props;
const cityGuide = {
  berlin: { slug: 'einbuergerungstest-berlin', city: 'Berlin' },
  hamburg: { slug: 'einbuergerungstest-hamburg', city: 'Hamburg' },
  hessen: { slug: 'einbuergerungstest-frankfurt', city: 'Frankfurt am Main' },
  bayern: { slug: 'einbuergerungstest-muenchen', city: 'München' },
  'nordrhein-westfalen': { slug: 'einbuergerungstest-koeln', city: 'Köln' },
}[stateSlug];
const examples = questions.filter((question) => !question.image || question.image === '-').slice(0, 2).map((question) => {
  const session = buildQuestionSessionItem(question, 'de');
  return { id: question.id, text: question.q_de, answer: session.optionsDe[session.correctIndex], explanation: getQuestionExplanation(question.id, 'de') };
});
---
{cityGuide && <section class="premium-panel mb-8 p-6 md:p-8" aria-labelledby="state-study-title" data-state-study={stateSlug}>
  <h2 id="state-study-title" class="text-2xl font-bold text-slate-950">So üben Sie die Fragen für {stateName}</h2>
  <p class="mt-3 leading-relaxed text-slate-700">Für Ihre Vorbereitung gehören die {questions.length} Fragen zu {stateName} zu den 300 allgemeinen Fragen. Im Einbürgerungstest bearbeiten Sie 30 allgemeine Aufgaben und drei Aufgaben zu Ihrem Bundesland. Üben Sie deshalb beide Bereiche.</p>
  <ol class="mt-4 list-decimal space-y-2 ps-6 text-slate-700">
    <li>Bearbeiten Sie die Landesfragen in der Übersicht und öffnen Sie die Erklärung zu unsicheren Antworten.</li>
    <li>Wiederholen Sie danach allgemeine Fragen, etwa zu Grundrechten und Demokratie.</li>
    <li>Wählen Sie in der Probeprüfung {stateName}, um 30 allgemeine und drei passende Landesfragen zu üben.</li>
  </ol>
  <div class="mt-5 grid gap-4 md:grid-cols-2">
    {examples.map((example) => <article class="min-w-0 rounded-xl border border-slate-200 bg-slate-50 p-4">
      <h3 class="font-bold text-slate-950">{example.text}</h3>
      <details class="mt-3"><summary class="cursor-pointer font-semibold text-emerald-900">Antwort und Erklärung anzeigen</summary><p class="mt-3 font-semibold">{example.answer}</p>{example.explanation && <p class="mt-2 text-sm leading-relaxed text-slate-700">{example.explanation.whyCorrect}</p>}</details>
      <a class="mt-4 inline-flex min-h-11 items-center font-semibold text-blue-800 underline" href={getPath(`de/frage/${example.id}/`)}>Frage mit Erklärung üben →</a>
    </article>)}
  </div>
  <nav class="mt-5 flex flex-wrap gap-4 text-sm font-semibold" aria-label={`Weiterlernen für ${stateName}`}>
    <a class="text-blue-800 underline" href={getPath(`de/exam/?state=${stateSlug}`)}>Probeprüfung für {stateName} starten →</a>
    <a class="text-blue-800 underline" href={getPath('de/fragen/')}>300 allgemeine Fragen üben →</a>
    <a class="text-blue-800 underline" href={getPath(`de/blog/${cityGuide.slug}/`)}>Anmeldung und Ablauf in {cityGuide.city} →</a>
  </nav>
  <p class="mt-5 text-sm leading-relaxed text-slate-600">Die Hinweise zur Anmeldung beziehen sich auf {cityGuide.city}. Dies ist eine unabhängige Lernhilfe; die anerkannte Prüfung findet bei einer zugelassenen Prüfstelle statt.</p>
  <p class="mt-3 text-sm"><a class="text-blue-800 underline" href={BAMF_TEST_SOURCE}>BAMF: Prüfungsaufbau ↗</a> · <a class="text-blue-800 underline" href={BAMF_QUESTION_CATALOG}>Offizieller Fragenkatalog ↗</a></p>
</section>}
