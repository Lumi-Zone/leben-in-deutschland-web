---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, type UiLanguage } from '../i18n/ui';

import { getPath } from '../utils/navigation';
import type { SupportedLang } from '../types/language';

interface Props {
  lang: SupportedLang;
  disableAlternates?: boolean;
}

const { lang, disableAlternates = false } = Astro.props as Props;
const t = useTranslations(lang as UiLanguage);
const currentPath = Astro.url.pathname;
const appDownloadHref = getPath(`${lang}/app`);

const navLinks = [
  { href: getPath(`${lang}/frage/1`), label: t('home.start_quiz'), destination: 'questions' },
  { href: getPath(`${lang}/exam`), label: t('features.exam.title'), destination: 'exam' },
  { href: getPath(`${lang}/support`), label: t('nav.support'), destination: 'support' },
  { href: getPath('de/blog'), label: t('nav.blog'), destination: 'blog', featured: true },
];

const isActive = (href: string) => {
  const path = currentPath.replace(/\/+$/, '');
  const target = href.replace(/\/+$/, '');
  const home = getPath(`${lang}/`).replace(/\/+$/, '');
  return path === target || (target !== home && path.startsWith(`${target}/`));
};
---

<header class="site-header sticky top-0 z-40">
  <nav class="container mx-auto px-3 py-3.5 sm:px-4 sm:py-4 rounded-2xl border border-white/70 bg-white/80 shadow-sm backdrop-blur-lg flex items-center justify-between relative">
      <div class="flex items-center gap-4">
          <a
            href={getPath(`${lang}/`)}
            aria-current={isActive(getPath(`${lang}/`)) ? 'page' : undefined}
            class="flex items-center gap-2 group"
          >
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center text-white font-bold text-xl shadow-lg group-hover:scale-105 transition-transform">
                  <img src={getPath("logo.svg")} alt="App Logo" class="w-full h-full object-cover rounded-xl" loading="eager" decoding="async" fetchpriority="high" />
              </div>
              <span class="text-lg sm:text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-700">{t("nav.home")}</span>
          </a>
      </div>

      <div class="hidden xl:flex gap-1.5 text-[13px] font-medium text-gray-600">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              data-umami-event="nav-link-click"
              data-umami-event-location="desktop-header"
              data-umami-event-destination={link.destination}
              data-umami-event-lang={lang}
              class={`px-2.5 py-2 rounded-lg whitespace-nowrap transition-colors ${
                link.featured
                  ? isActive(link.href)
                    ? 'text-white bg-gradient-to-r from-blue-700 to-cyan-600 shadow-sm'
                    : 'text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-100'
                  : isActive(link.href)
                    ? 'text-blue-700 bg-blue-50'
                    : 'hover:text-blue-600 hover:bg-gray-50'
              }`}
            >
              {link.label}
            </a>
          ))}
      </div>

      <div class="header-actions flex items-center gap-2.5">
        <a
          href={appDownloadHref}
          data-umami-event="app-page-opened"
          data-umami-event-location="desktop-header"
          data-umami-event-lang={lang}
          class="hidden sm:inline-flex items-center rounded-xl border border-[#302821] bg-[#3f352c] px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[#2f2822] hover:shadow-md"
        >
          {t('question.practice_app')}
        </a>
        <LanguageSwitcher lang={lang} disableAlternates={disableAlternates} />
        <button
          type="button"
          class="xl:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl border border-gray-200 text-gray-700 bg-white hover:bg-gray-50 transition-colors"
          data-mobile-menu-toggle
          data-umami-event="mobile-menu-opened"
          data-umami-event-lang={lang}
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          aria-label={t('nav.open_menu')}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
  </nav>
</header>

  <div class="mobile-nav-overlay xl:hidden fixed inset-0 z-40 bg-gray-900/45 opacity-0 pointer-events-none transition-opacity duration-300" data-mobile-menu-overlay data-mobile-menu-close></div>

  <aside
    id="mobile-nav-drawer"
    class="mobile-nav-panel xl:hidden fixed top-0 right-0 z-50 h-full w-[min(22rem,92vw)] bg-white border-l border-gray-200 shadow-2xl translate-x-full transition-transform duration-300"
    data-mobile-menu-panel
    role="dialog"
    aria-modal="true"
    aria-label={t("nav.home")}
    aria-hidden="true"
    inert
  >
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
      <span class="font-semibold text-gray-900">{t('nav.home')}</span>
      <button
        type="button"
        class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors"
        data-mobile-menu-close
        aria-label={t('nav.close_menu')}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="px-4 py-5 space-y-2">
      <a
        href={appDownloadHref}
        data-umami-event="app-page-opened"
        data-umami-event-location="mobile-drawer"
        data-umami-event-lang={lang}
        class="block rounded-xl border border-[#302821] bg-[#3f352c] px-4 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-[#2f2822]"
      >
        {t('question.practice_app')}
      </a>
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          data-umami-event="nav-link-click"
          data-umami-event-location="mobile-drawer"
          data-umami-event-destination={link.destination}
          data-umami-event-lang={lang}
          class={`block px-4 py-3 rounded-xl font-medium transition-colors ${
            link.featured
              ? isActive(link.href)
                ? 'text-white bg-gradient-to-r from-blue-700 to-cyan-600'
                : 'text-blue-700 bg-blue-50 border border-blue-200 hover:bg-blue-100'
              : isActive(link.href)
                ? 'text-blue-700 bg-blue-50'
                : 'text-gray-700 hover:text-blue-600 hover:bg-gray-50'
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>
  </aside>

<script is:inline>
  (() => {
    const toggleButton = document.querySelector('[data-mobile-menu-toggle]');
    const drawer = document.querySelector('[data-mobile-menu-panel]');
    const overlay = document.querySelector('[data-mobile-menu-overlay]');
    const closeTargets = document.querySelectorAll('[data-mobile-menu-close]');
    let previouslyFocusedElement = null;

    if (!toggleButton || !drawer || !overlay) return;

    const getFocusableElements = () =>
      Array.from(
        drawer.querySelectorAll(
          'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
        )
      );

    const setOpen = (open) => {
      toggleButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      drawer.inert = !open;
      drawer.classList.toggle('translate-x-full', !open);
      overlay.classList.toggle('opacity-0', !open);
      overlay.classList.toggle('pointer-events-none', !open);
      document.body.classList.toggle('overflow-hidden', open);

      if (open) {
        document.querySelector('.language-menu')?.removeAttribute('open');
        previouslyFocusedElement = document.activeElement;
        const [firstFocusable] = getFocusableElements();
        if (firstFocusable) firstFocusable.focus();
      } else if (previouslyFocusedElement && typeof previouslyFocusedElement.focus === 'function') {
        previouslyFocusedElement.focus();
        previouslyFocusedElement = null;
      }
    };

    toggleButton.addEventListener('click', () => {
      const expanded = toggleButton.getAttribute('aria-expanded') === 'true';
      setOpen(!expanded);
    });

    window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
      if (event.matches && toggleButton.getAttribute('aria-expanded') === 'true') setOpen(false);
    });

    closeTargets.forEach((target) => {
      target.addEventListener('click', () => setOpen(false));
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      const isDrawerOpen = drawer.getAttribute('aria-hidden') === 'false';
      if (!isDrawerOpen) return;

      if (event.key === 'Escape') {
        setOpen(false);
        return;
      }

      if (event.key === 'Tab') {
        const focusables = getFocusableElements();
        if (focusables.length === 0) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement;

        if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

<style>
  .site-header{background:rgb(246 248 243 / .94);border-bottom:1px solid #dfe5dc;backdrop-filter:blur(16px)}
  .site-header>nav{max-width:1180px;min-height:86px;border:0;border-radius:0;background:transparent;box-shadow:none;backdrop-filter:none;padding:18px 0}
  .site-header>nav>div:first-child>a>div{width:38px;height:38px;box-shadow:none;border-radius:10px}
  .site-header>nav>div:first-child>a>span{font-size:1rem;color:#182d26;background:none;max-width:170px;line-height:1.2;letter-spacing:-.03em}
  .site-header nav a[data-umami-event="nav-link-click"]{background:transparent;border:0;color:#526359;font-size:.85rem}
  .site-header nav a[data-umami-event="nav-link-click"]:hover,.site-header nav a[aria-current="page"][data-umami-event]{color:#137b54;background:#e9efe5}
  .site-header nav a[data-umami-event="app-page-opened"]{background:#183329;border:0;border-radius:8px;font-size:.8rem;padding:12px 16px;box-shadow:none}
  @media(max-width:1244px){.site-header>nav{margin-inline:32px;width:auto}}
  .header-actions{flex-shrink:0}
  .site-header>nav>div:first-child,.site-header>nav>div:first-child>a{min-width:0}
  .site-header>nav>div:first-child>a>div{flex-shrink:0}
  .mobile-nav-overlay{z-index:70}
  .mobile-nav-panel{z-index:80;height:100dvh;width:min(22rem,calc(100vw - 24px));overflow-y:auto;overscroll-behavior:contain;padding-bottom:env(safe-area-inset-bottom)}
  .mobile-nav-panel[aria-hidden="true"]{visibility:hidden;pointer-events:none}
  .mobile-nav-panel>div:first-child{gap:12px;padding-top:max(1rem,env(safe-area-inset-top))}
  .mobile-nav-panel [data-mobile-menu-close]{flex-shrink:0;min-width:44px;min-height:44px}
  @media(max-width:1279px){.site-header>nav{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px}}
  @media(max-width:760px){
    .site-header>nav{margin-inline:16px;min-height:72px;padding:12px 0;gap:12px}
    .site-header>nav>div:first-child>a>div{width:34px;height:34px}
    .site-header>nav>div:first-child>a>span{font-size:.8125rem;max-width:126px;min-width:0;overflow-wrap:anywhere;line-height:1.25}
    .site-header>nav>div:last-child{gap:8px}
    .site-header [data-mobile-menu-toggle]{flex-shrink:0}
  }
</style>
